                        <div class="story-text" id="story-text-content">
                            会話イベント...
                        </div>
                    </div>

                    <!-- ボス表示領域 -->
                    <div class="boss-area">
                        <div class="boss-speech" id="boss-speech-bubble">HALLO!</div>
                        <div class="boss-img-container" id="boss-container">
                            <img src="" alt="Boss" class="boss-img" id="boss-img">
                        </div>
                        <div style="font-weight: 800; font-size: 16px; margin-top: 4px;" id="boss-name-label">Boss Name</div>
                        
                        <!-- ボスHP -->
                        <div class="hp-bar-outer">
                            <div class="hp-bar-inner" id="boss-hp-fill" style="width: 100%;"></div>
                            <div class="hp-text" id="boss-hp-text">HP: 1000 / 1000</div>
                        </div>
                    </div>

                    <!-- プレイヤーチーム表示 -->
                    <div style="margin-top: 10px;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 12px; font-weight: 700;">YOUR TEAM</span>
                            <span style="font-size: 11px; font-weight: 600; color: var(--text-sub);" id="player-hp-num">HP: 3500 / 3500</span>
                        </div>
                        
                        <div class="hp-bar-outer" style="height: 10px;">
                            <div class="hp-bar-inner" id="player-hp-fill" style="width: 100%; background: linear-gradient(90deg, #34C759, #30B0C7);"></div>
                        </div>

                        <!-- チーム国ボール5体 -->
                        <div class="team-balls-grid" id="team-balls-container">
                            <!-- JSで挿入 -->
                        </div>
                    </div>
                </div>

                <!-- パズルボードカード -->
                <div class="glass-card">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <h2>6x5 ドロップパズル</h2>
                        <span style="font-size: 12px; font-weight: 700; color: var(--accent-primary);" id="game-status-text">ドロップを動かそう！</span>
                    </div>

                    <div class="puzzle-board-container">
                        <div class="puzzle-timer-bar">
                            <div class="puzzle-timer-fill" id="timer-fill" style="width: 100%;"></div>
                        </div>

                        <!-- パズルグリッド -->
                        <div class="puzzle-grid" id="puzzle-board">
                            <!-- 30個のオーブが生成されます -->
                        </div>
                        <div class="combo-floating" id="combo-display">1 COMBO!</div>
                    </div>

                    <div style="margin-top: 14px; display: flex; gap: 8px; justify-content: center;">
                        <button class="ai-btn ai-btn-secondary" onclick="resetBattle()">
                            <span class="material-symbols-outlined">refresh</span>
                            リスタート
                        </button>
                    </div>
                </div>
            </section>

            <!-- 2. キャラ強化・チーム編成ビュー -->
            <section id="view-upgrade" class="view">
                <div class="glass-card">

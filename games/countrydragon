            <!-- 5. 設定ビュー -->
            <section id="view-components" class="view">
                <div class="glass-card">
                    <h2>ゲーム設定</h2>
                    
                    <!-- 太いスライダー：操作時間設定 -->
                    <div class="slider-wrapper">
                        <div class="slider-label-row">
                            <span>パズル移動制限時間 (秒)</span>
                            <span id="val-time">4.0秒</span>
                        </div>
                        <div class="thick-slider-container">
                            <div class="thick-slider-fill" id="slider-time-fill" style="width: 50%;"></div>
                            <input type="range" class="thick-slider-input" min="2" max="8" step="0.5" value="4" oninput="updateThickSlider('slider-time-fill', 'val-time', this.value, '秒'); setMoveTimeLimit(this.value)">
                        </div>
                    </div>

                    <div style="margin-top: 16px;">
                        <button class="ai-btn" style="width: 100%; justify-content: center;" onclick="showToast('設定を保存しました！')">
                            <span class="material-symbols-outlined">save</span>
                            設定を保存
                        </button>
                    </div>
                </div>

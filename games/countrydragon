    <!-- ダイアログ -->
    <div class="dialog-overlay" id="main-dialog">
        <div class="glass-dialog">
            <span class="material-symbols-outlined" style="font-size: 44px; color: var(--accent-primary);" id="dialog-icon">emoji_events</span>

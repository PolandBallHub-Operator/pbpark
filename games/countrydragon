    <!-- トースト -->
    <div class="toast" id="toast-message">メッセージ</div>

    <script>
        /**
         * Country & Balls - Complete Game System
         */

        const BASE_BALL_URL = "https://raw.githubusercontent.com/Polandballhub-Operator/pbimagesPublic/refs/heads/main/balls/";
        
        const COUNTRIES = [
            "germany", "japan", "china", "italy", "sierraleone", "russia", 
            "france", "poland", "england472x600", "usa", "korea", "austria"
        ];

        const EXPRESSIONS = [
            "anger.png", "dissatisfaction.png", "happy.png", "itome.png", 
            "lol.png", "normal.png", "plot.png", "smile.png", "surprise.png"
        ];

        function getBallImageUrl(country, expression = "normal.png") {
            if (country === "developer_tangle") {
                return "https://raw.githubusercontent.com/Polandballhub-Operator/pbimagesPublic/refs/heads/main/balls/ltangle/Pickel.png";
            }
            return `${BASE_BALL_URL}${country}/${expression}`;
        }

        // リソース
        let userResources = {
            clay: 150,
            coin: 500
        };

        // プレイヤーチームデータ (強化可能)
        let playerTeam = [
            { id: "japan", country: "japan", type: "fire", name: "Japan", level: 1, baseAtk: 220, hpBonus: 300 },
            { id: "france", country: "france", type: "water", name: "France", level: 1, baseAtk: 190, hpBonus: 280 },
            { id: "sierraleone", country: "sierraleone", type: "wood", name: "Sierra Leone", level: 1, baseAtk: 180, hpBonus: 250 },
            { id: "usa", country: "usa", type: "light", name: "USA", level: 1, baseAtk: 250, hpBonus: 350 },
            { id: "germany", country: "germany", type: "dark", name: "Germany", level: 1, baseAtk: 230, hpBonus: 320 }
        ];

        // ストーリー＆ボス定義
        const STAGES = [
            {
                id: 1,
                name: "第1章: ドイツの秩序",
                bossCountry: "germany",
                bossName: "Germany Ball",
                hp: 1500,
                atk: 250,
                dialog: "Guten Tag! 粘土とパズルのルールを厳格に適用する！",
                speech: "ORDNUNG!!",
                rewardClay: 50,
                rewardCoin: 100
            },
            {
                id: 2,
                name: "第2章: 極寒のロシア",
                bossCountry: "russia",
                bossName: "Russia Ball",
                hp: 3000,
                atk: 450,
                dialog: "Xaxaxa! 寒さと強力なコンボに耐えられるかな？",
                speech: "VODKA POWER!",
                rewardClay: 100,
                rewardCoin: 200
            },
            {
                id: 3,
                name: "第3章: 自由の重圧",
                bossCountry: "usa",
                bossName: "USA Ball",
                hp: 5500,
                atk: 700,
                dialog: "Hey guys! 俺のビッグなバーガーパワーを見せてやる！",
                speech: "FREEDOM!!",
                rewardClay: 150,
                rewardCoin: 350
            },
            {
                id: 4,
                name: "第4章: 紳士のティータイム",
                bossCountry: "england472x600",
                bossName: "UK Ball",
                hp: 8500,
                atk: 950,
                dialog: "Bloody hell! 縦長だからってバカにするんじゃないよ！",
                speech: "TEA TIME CHAPS!",
                rewardClay: 250,
                rewardCoin: 500
            },
            {
                id: 5,
                name: "最終章: 開発者の刺客",
                bossCountry: "developer_tangle",
                bossName: "DeveloperTangle",
                hp: 15000,
                atk: 1400,
                dialog: "I am DeveloperTangle... ピッケルの前にひれ伏すのだ！",
                speech: "PICKEL SMASH!!",
                rewardClay: 500,
                rewardCoin: 1000
            }
        ];

        let currentStageIdx = 0;
        let isBossRush = false;
        let rushScore = 0;
        let bestRushScore = 0;

        // ゲーム状態
        let bossMaxHp = 1000;
        let bossCurrentHp = 1000;
        let playerMaxHp = 3500;
        let playerCurrentHp = 3500;
        let bossTurnCounter = 3;
        let moveTimeLimit = 4.0;
        let isDragging = false;
        let isProcessingMatches = false;
        let activeOrb = null;
        let dragTimer = null;
        let remainingTime = 0;
        let maxComboRecord = 0;

        const ORB_TYPES = [
            { type: "fire", icon: "local_fire_department", class: "orb-fire" },
            { type: "water", icon: "water_drop", class: "orb-water" },
            { type: "wood", icon: "forest", class: "orb-wood" },
            { type: "light", icon: "light_mode", class: "orb-light" },
            { type: "dark", icon: "dark_mode", class: "orb-dark" },
            { type: "heart", icon: "favorite", class: "orb-heart" }
        ];

        const BOARD_ROWS = 5;
        const BOARD_COLS = 6;
        let boardState = [];

        // リソース表示更新
        function updateResourceUI() {
            document.getElementById('res-clay').textContent = userResources.clay;
            document.getElementById('res-coin').textContent = userResources.coin;
        }

        // ステージ選択UIの作成
        function renderStageChips() {
            const container = document.getElementById('stage-chip-container');
            container.innerHTML = '';

            STAGES.forEach((stg, idx) => {
                const chip = document.createElement('div');
                chip.className = `stage-chip ${idx === currentStageIdx ? 'active' : ''}`;
                chip.innerHTML = `<span class="material-symbols-outlined" style="font-size:16px;">flag</span> STAGE ${stg.id}`;
                chip.onclick = () => selectStage(idx);
                container.appendChild(chip);
            });
        }

        function selectStage(idx) {
            isBossRush = false;
            currentStageIdx = idx;
            renderStageChips();
            loadStageData();
        }

        function loadStageData() {
            const stg = STAGES[currentStageIdx];
            document.getElementById('boss-stage-badge').textContent = `STAGE ${stg.id}`;
            document.getElementById('boss-name-label').textContent = stg.bossName;
            
            bossMaxHp = stg.hp;
            bossCurrentHp = stg.hp;
            bossTurnCounter = 3;

            // ボス画像
            const bossImg = document.getElementById('boss-img');
            const isUk = stg.bossCountry === "england472x600";
            bossImg.src = getBallImageUrl(stg.bossCountry, "anger.png");
            bossImg.className = `boss-img ${isUk ? 'uk-boss' : ''}`;

            // 会話テキスト
            const storyImg = document.getElementById('story-avatar-img');
            storyImg.src = getBallImageUrl(stg.bossCountry, "normal.png");
            storyImg.className = isUk ? 'uk-ball' : '';
            document.getElementById('story-text-content').textContent = stg.dialog;

            // プレイヤー最大HPの計算 (各ボールのレベルとボーナス)
            playerMaxHp = playerTeam.reduce((acc, member) => acc + (member.hpBonus + member.level * 80), 1000);
            playerCurrentHp = playerMaxHp;

            updateHpBars();
            document.getElementById('turn-counter').textContent = `NEXT ATTACK: ${bossTurnCounter}`;
            renderTeamBalls();
            initPuzzleBoard();
        }

        function renderTeamBalls(expressionMap = {}) {
            const container = document.getElementById('team-balls-container');
            container.innerHTML = '';

            playerTeam.forEach(member => {
                const expr = expressionMap[member.country] || (playerCurrentHp < playerMaxHp * 0.3 ? "itome.png" : "normal.png");
                const imgUrl = getBallImageUrl(member.country, expr);
                const isUk = member.country === "england472x600";

                const ballDiv = document.createElement('div');
                ballDiv.className = 'team-ball-item';
                ballDiv.innerHTML = `
                    <div class="ball-avatar">
                        <img src="${imgUrl}" alt="${member.name}" class="${isUk ? 'uk-ball' : ''}">
                        <div class="ball-lvl-tag">Lv.${member.level}</div>
                    </div>
                    <div class="ball-name">${member.name}</div>
                `;
                container.appendChild(ballDiv);
            });
        }

        function updateTeamExpressions(expressionName) {
            const map = {};
            playerTeam.forEach(m => map[m.country] = expressionName);
            renderTeamBalls(map);
        }

        // パズルボード初期化
        function initPuzzleBoard() {
            const boardEl = document.getElementById('puzzle-board');
            boardEl.innerHTML = '';
            boardState = [];

            for (let i = 0; i < BOARD_ROWS * BOARD_COLS; i++) {
                const randomOrb = getRandomOrbType();
                boardState.push(randomOrb);

                const orbEl = createOrbElement(randomOrb, i);
                boardEl.appendChild(orbEl);
            }

            checkAndResolveInitialMatches();
        }

        function getRandomOrbType() {
            return ORB_TYPES[Math.floor(Math.random() * ORB_TYPES.length)];
        }

        function createOrbElement(orbData, index) {
            const div = document.createElement('div');
            div.className = `orb ${orbData.class}`;
            div.dataset.index = index;
            div.innerHTML = `<span class="material-symbols-outlined">${orbData.icon}</span>`;
            div.addEventListener('pointerdown', (e) => onOrbPointerDown(e, index));
            return div;
        }

        function onOrbPointerDown(e, index) {
            if (isProcessingMatches) return;

            isDragging = true;
            activeOrb = index;
            updateTeamExpressions("plot.png");

            const boardEl = document.getElementById('puzzle-board');
            boardEl.children[index].classList.add('dragging');

            startMoveTimer();

            window.addEventListener('pointermove', onOrbPointerMove);
            window.addEventListener('pointerup', onOrbPointerUp);
        }

        function onOrbPointerMove(e) {
            if (!isDragging) return;

            const boardEl = document.getElementById('puzzle-board');
            const rect = boardEl.getBoundingClientRect();

            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            if (x < 0 || x >= rect.width || y < 0 || y >= rect.height) return;

            const col = Math.floor((x / rect.width) * BOARD_COLS);
            const row = Math.floor((y / rect.height) * BOARD_ROWS);
            const targetIndex = row * BOARD_COLS + col;

            if (targetIndex >= 0 && targetIndex < BOARD_ROWS * BOARD_COLS && targetIndex !== activeOrb) {
                swapOrbs(activeOrb, targetIndex);
                activeOrb = targetIndex;
            }
        }

        function swapOrbs(idx1, idx2) {
            const temp = boardState[idx1];
            boardState[idx1] = boardState[idx2];
            boardState[idx2] = temp;

            const boardEl = document.getElementById('puzzle-board');
            const orbEls = boardEl.children;

            updateOrbElement(orbEls[idx1], boardState[idx1]);
            updateOrbElement(orbEls[idx2], boardState[idx2]);

            orbEls[idx1].classList.remove('dragging');
            orbEls[idx2].classList.add('dragging');
        }

        function updateOrbElement(el, orbData) {
            el.className = `orb ${orbData.class}`;
            el.innerHTML = `<span class="material-symbols-outlined">${orbData.icon}</span>`;
        }

        function startMoveTimer() {
            remainingTime = moveTimeLimit;
            const fill = document.getElementById('timer-fill');
            fill.style.width = '100%';

            const startTime = Date.now();
            clearInterval(dragTimer);

            dragTimer = setInterval(() => {
                const elapsed = (Date.now() - startTime) / 1000;
                remainingTime = Math.max(0, moveTimeLimit - elapsed);
                fill.style.width = `${(remainingTime / moveTimeLimit) * 100}%`;

                if (remainingTime <= 0) {
                    onOrbPointerUp();
                }
            }, 50);
        }

        function onOrbPointerUp() {
            if (!isDragging) return;
            isDragging = false;
            clearInterval(dragTimer);

            window.removeEventListener('pointermove', onOrbPointerMove);
            window.removeEventListener('pointerup', onOrbPointerUp);

            const boardEl = document.getElementById('puzzle-board');
            if (activeOrb !== null && boardEl.children[activeOrb]) {
                boardEl.children[activeOrb].classList.remove('dragging');
            }
            activeOrb = null;

            processPuzzleMatches();
        }

        async function processPuzzleMatches() {
            isProcessingMatches = true;
            document.getElementById('game-status-text').textContent = 'コンボ判定中...';

            let comboCount = 0;
            let totalDamage = 0;
            let totalHeal = 0;

            while (true) {
                const matches = findMatches();
                if (matches.length === 0) break;

                comboCount++;
                showComboEffect(comboCount);

                const boardEl = document.getElementById('puzzle-board');
                matches.forEach(idx => {
                    if (boardEl.children[idx]) {
                        boardEl.children[idx].classList.add('matched');
                    }
                    
                    const type = boardState[idx].type;
                    if (type === 'heart') {
                        totalHeal += 180;
                    } else {
                        // プレイヤーの強化後ステータスを攻撃力に適用
                        const matchingMember = playerTeam.find(m => m.type === type);
                        const baseAtk = matchingMember ? (matchingMember.baseAtk + matchingMember.level * 40) : 200;
                        totalDamage += baseAtk;
                    }
                });

                await sleep(300);

                matches.forEach(idx => boardState[idx] = null);
                applyGravity();

                await sleep(250);
            }

            if (comboCount > maxComboRecord) {
                maxComboRecord = comboCount;
                renderAchievements();
            }

            if (comboCount > 0) {
                const multiplier = 1 + (comboCount - 1) * 0.3;
                totalDamage = Math.round(totalDamage * multiplier);
                totalHeal = Math.round(totalHeal * multiplier);

                updateTeamExpressions(comboCount >= 3 ? "lol.png" : "happy.png");
                await executePlayerTurn(totalDamage, totalHeal, comboCount);
            } else {
                updateTeamExpressions("normal.png");
            }

            document.getElementById('game-status-text').textContent = 'ドロップを動かそう！';
            document.getElementById('timer-fill').style.width = '100%';
            isProcessingMatches = false;
        }

        function findMatches() {
            const matchedIndices = new Set();

            for (let r = 0; r < BOARD_ROWS; r++) {
                for (let c = 0; c < BOARD_COLS - 2; c++) {
                    const idx = r * BOARD_COLS + c;
                    const orb1 = boardState[idx];
                    const orb2 = boardState[idx + 1];
                    const orb3 = boardState[idx + 2];

                    if (orb1 && orb2 && orb3 && orb1.type === orb2.type && orb2.type === orb3.type) {
                        matchedIndices.add(idx);
                        matchedIndices.add(idx + 1);
                        matchedIndices.add(idx + 2);
                    }
                }
            }

            for (let c = 0; c < BOARD_COLS; c++) {
                for (let r = 0; r < BOARD_ROWS - 2; r++) {
                    const idx = r * BOARD_COLS + c;
                    const orb1 = boardState[idx];
                    const orb2 = boardState[idx + BOARD_COLS];
                    const orb3 = boardState[idx + BOARD_COLS * 2];

                    if (orb1 && orb2 && orb3 && orb1.type === orb2.type && orb2.type === orb3.type) {
                        matchedIndices.add(idx);
                        matchedIndices.add(idx + BOARD_COLS);
                        matchedIndices.add(idx + BOARD_COLS * 2);
                    }
                }
            }

            return Array.from(matchedIndices);
        }

        function applyGravity() {
            for (let c = 0; c < BOARD_COLS; c++) {
                let emptySpots = 0;
                for (let r = BOARD_ROWS - 1; r >= 0; r--) {
                    const idx = r * BOARD_COLS + c;
                    if (boardState[idx] === null) {
                        emptySpots++;
                    } else if (emptySpots > 0) {
                        const newIdx = (r + emptySpots) * BOARD_COLS + c;
                        boardState[newIdx] = boardState[idx];
                        boardState[idx] = null;
                    }
                }
                for (let r = 0; r < emptySpots; r++) {
                    const idx = r * BOARD_COLS + c;
                    boardState[idx] = getRandomOrbType();
                }
            }

            const boardEl = document.getElementById('puzzle-board');
            for (let i = 0; i < BOARD_ROWS * BOARD_COLS; i++) {
                updateOrbElement(boardEl.children[i], boardState[i]);
                boardEl.children[i].classList.remove('matched');
            }
        }

        function checkAndResolveInitialMatches() {
            let matches = findMatches();
            while (matches.length > 0) {
                matches.forEach(idx => boardState[idx] = getRandomOrbType());
                matches = findMatches();
            }
            const boardEl = document.getElementById('puzzle-board');
            for (let i = 0; i < BOARD_ROWS * BOARD_COLS; i++) {
                updateOrbElement(boardEl.children[i], boardState[i]);
            }
        }

        function showComboEffect(combo) {
            const display = document.getElementById('combo-display');
            display.textContent = `${combo} COMBO!`;
            display.classList.remove('active');
            void display.offsetWidth;
            display.classList.add('active');
        }

        async function executePlayerTurn(damage, heal, combo) {
            if (heal > 0) {
                playerCurrentHp = Math.min(playerMaxHp, playerCurrentHp + heal);
                updateHpBars();
                showToast(`💖 ${heal} HP 回復！`);
            }

            if (damage > 0) {
                bossCurrentHp = Math.max(0, bossCurrentHp - damage);
                updateHpBars();

                const bossImg = document.getElementById('boss-img');
                bossImg.classList.add('hit-shake');
                setTimeout(() => bossImg.classList.remove('hit-shake'), 400);

                showToast(`⚔️ ${damage} ダメージ！ (${combo} Combo)`);
            }

            // 勝利判定
            if (bossCurrentHp <= 0) {
                await sleep(500);

                if (isBossRush) {
                    rushScore++;
                    if (rushScore > bestRushScore) {
                        bestRushScore = rushScore;
                        document.getElementById('best-rush-score').textContent = `${bestRushScore} 撃破`;
                    }
                    showToast(`ボスラッシュ撃破！ (${rushScore}体目)`);
                    loadBossRushNext();
                } else {
                    const stg = STAGES[currentStageIdx];
                    userResources.clay += stg.rewardClay;
                    userResources.coin += stg.rewardCoin;
                    updateResourceUI();

                    showGameDialog(true, "VICTORY!", `${stg.bossName} を倒した！ 報酬: 粘土+${stg.rewardClay}, コイン+${stg.rewardCoin}`);
                    updateTeamExpressions("smile.png");
                }
                return;
            }

            bossTurnCounter--;
            if (bossTurnCounter <= 0) {
                await sleep(600);
                await executeBossAttack();
                bossTurnCounter = 3;
            }

            document.getElementById('turn-counter').textContent = `NEXT ATTACK: ${bossTurnCounter}`;
        }

        async function executeBossAttack() {
            const stg = isBossRush ? { speech: "RUSH ATTACK!", atk: 600 + rushScore * 200 } : STAGES[currentStageIdx];
            showBossSpeech(stg.speech);
            updateTeamExpressions("anger.png");

            const bossDamage = Math.floor(stg.atk * (0.8 + Math.random() * 0.4));
            playerCurrentHp = Math.max(0, playerCurrentHp - bossDamage);
            updateHpBars();

            showToast(`💥 ボスの攻撃！ ${bossDamage} ダメージ！`);

            if (playerCurrentHp <= 0) {
                await sleep(500);
                updateTeamExpressions("surprise.png");
                showGameDialog(false, "GAME OVER", isBossRush ? `ボスラッシュ終了！ 記録: ${rushScore}体撃破` : "ボスの攻撃に倒れてしまった...");
            }
        }

        function showBossSpeech(text) {
            const bubble = document.getElementById('boss-speech-bubble');
            bubble.textContent = text;
            bubble.classList.add('active');
            setTimeout(() => bubble.classList.remove('active'), 1800);
        }

        function updateHpBars() {
            const bossPct = (bossCurrentHp / bossMaxHp) * 100;
            document.getElementById('boss-hp-fill').style.width = `${bossPct}%`;
            document.getElementById('boss-hp-text').textContent = `HP: ${bossCurrentHp} / ${bossMaxHp}`;

            const playerPct = (playerCurrentHp / playerMaxHp) * 100;
            document.getElementById('player-hp-fill').style.width = `${playerPct}%`;
            document.getElementById('player-hp-num').textContent = `HP: ${playerCurrentHp} / ${playerMaxHp}`;
        }

        function resetBattle() {
            if (isBossRush) {
                startBossRush();
            } else {
                loadStageData();
            }
            showToast("バトルをリセットしました！");
        }

        // ボスラッシュ進行
        function startBossRush() {
            switchView('view-home');
            isBossRush = true;
            rushScore = 0;
            loadBossRushNext();
        }

        function loadBossRushNext() {
            document.getElementById('boss-stage-badge').textContent = `RUSH #${rushScore + 1}`;
            
            // ランダムにボスを選択
            const randomBossCountry = COUNTRIES[Math.floor(Math.random() * COUNTRIES.length)];
            const bossName = randomBossCountry.toUpperCase() + " BALL";
            
            bossMaxHp = 2000 + rushScore * 1500;
            bossCurrentHp = bossMaxHp;
            bossTurnCounter = 3;

            document.getElementById('boss-name-label').textContent = bossName;
            const bossImg = document.getElementById('boss-img');
            const isUk = randomBossCountry === "england472x600";
            bossImg.src = getBallImageUrl(randomBossCountry, "anger.png");
            bossImg.className = `boss-img ${isUk ? 'uk-boss' : ''}`;

            document.getElementById('story-text-content').textContent = `ボスラッシュ第 ${rushScore + 1} 刺客！ 倒せるかな？`;

            playerMaxHp = playerTeam.reduce((acc, member) => acc + (member.hpBonus + member.level * 80), 1000);
            playerCurrentHp = playerMaxHp;

            updateHpBars();
            document.getElementById('turn-counter').textContent = `NEXT ATTACK: ${bossTurnCounter}`;
            renderTeamBalls();
            initPuzzleBoard();
        }

        // キャラ強化画面描画
        function renderUpgradeList() {
            const container = document.getElementById('upgrade-list-container');
            container.innerHTML = '';

            playerTeam.forEach((member, idx) => {
                const isUk = member.country === "england472x600";
                const costClay = member.level * 30;
                const costCoin = member.level * 50;

                const card = document.createElement('div');
                card.className = 'upgrade-card';
                card.innerHTML = `
                    <div class="upgrade-info">
                        <div class="upgrade-avatar">
                            <img src="${getBallImageUrl(member.country, 'happy.png')}" class="${isUk ? 'uk-ball' : ''}" alt="${member.name}">
                        </div>
                        <div>
                            <div style="font-weight:700; font-size:14px;">${member.name} <span class="badge">Lv.${member.level}</span></div>
                            <div style="font-size:11px; color:var(--text-sub);">ATK: ${member.baseAtk + member.level * 40} | HP: +${member.hpBonus + member.level * 80}</div>
                        </div>
                    </div>
                    <button class="ai-btn ai-btn-sm" onclick="upgradeMember(${idx})">
                        強化 (${costClay}粘土)
                    </button>
                `;
                container.appendChild(card);
            });
        }

        function upgradeMember(idx) {
            const member = playerTeam[idx];
            const costClay = member.level * 30;
            const costCoin = member.level * 50;

            if (userResources.clay >= costClay && userResources.coin >= costCoin) {
                userResources.clay -= costClay;
                userResources.coin -= costCoin;
                member.level++;
                
                updateResourceUI();
                renderUpgradeList();
                showToast(`${member.name} が Lv.${member.level} にレベルアップ！`);
            } else {
                showToast("強化素材 (粘土/コイン) が足りません！");
            }
        }

        // 実績一覧の描画
        function renderAchievements() {
            const container = document.getElementById('achievements-container');
            if (!container) return;
            container.innerHTML = `
                <div class="list-item">
                    <div>
                        <div class="list-item-title">最高コンボ達成</div>
                        <div class="list-item-desc">記録: ${maxComboRecord} コンボ</div>
                    </div>
                    <span class="badge">${maxComboRecord >= 5 ? '達成！' : '挑戦中'}</span>
                </div>
                <div class="list-item">
                    <div>
                        <div class="list-item-title">ボスラッシュ最高記録</div>
                        <div class="list-item-desc">記録: ${bestRushScore} 体撃破</div>
                    </div>
                    <span class="badge">${bestRushScore >= 3 ? '達成！' : '挑戦中'}</span>
                </div>
            `;
        }

        // 図鑑ギャラリー
        function renderGallery() {
            const container = document.getElementById('gallery-container');
            container.innerHTML = '';

            COUNTRIES.forEach(country => {
                const isUk = country === "england472x600";
                const displayName = isUk ? "UK" : country.charAt(0).toUpperCase() + country.slice(1);
                let currentExprIdx = 5;

                const card = document.createElement('div');
                card.className = 'gallery-card glass-card';
                card.style.margin = '0';
                card.style.padding = '8px';

                card.innerHTML = `
                    <img src="${getBallImageUrl(country, EXPRESSIONS[currentExprIdx])}" class="gallery-ball-img ${isUk ? 'uk-ball' : ''}" id="gal-img-${country}" alt="${displayName}">
                    <div style="font-size: 11px; font-weight: 700; margin-top: 6px; text-align: center;">${displayName}</div>
                    <div style="font-size: 9px; color: var(--text-sub);" id="gal-expr-${country}">normal</div>
                `;

                card.addEventListener('click', () => {
                    currentExprIdx = (currentExprIdx + 1) % EXPRESSIONS.length;
                    const exprFile = EXPRESSIONS[currentExprIdx];
                    const imgEl = document.getElementById(`gal-img-${country}`);
                    const labelEl = document.getElementById(`gal-expr-${country}`);

                    imgEl.src = getBallImageUrl(country, exprFile);
                    labelEl.textContent = exprFile.replace('.png', '');
                });

                container.appendChild(card);
            });
        }

        function setMoveTimeLimit(val) {
            moveTimeLimit = parseFloat(val);
        }

        function startGame() {
            document.getElementById('title-screen').classList.add('hidden');
            showToast("Country & Balls へようこそ！");
        }

        function openTitleScreen() {
            document.getElementById('title-screen').classList.remove('hidden');
        }

        function showGameDialog(isWin, title, desc) {
            document.getElementById('dialog-icon').textContent = isWin ? 'emoji_events' : 'sentiment_very_dissatisfied';
            document.getElementById('dialog-title').textContent = title;
            document.getElementById('dialog-desc').textContent = desc;
            document.getElementById('main-dialog').classList.add('active');
        }

        function closeDialog() {
            document.getElementById('main-dialog').classList.remove('active');
        }

        function showToast(msg) {
            const toast = document.getElementById('toast-message');
            toast.textContent = msg;
            toast.classList.add('active');
            setTimeout(() => toast.classList.remove('active'), 2200);
        }

        function switchView(viewId) {
            document.querySelectorAll('.nav-item').forEach(n => {
                n.classList.remove('active');
                if (n.getAttribute('data-view') === viewId) n.classList.add('active');
            });

            document.querySelectorAll('.view').forEach(v => {
                v.classList.remove('active');
                if (v.id === viewId) v.classList.add('active');
            });

            if (viewId === 'view-upgrade') renderUpgradeList();
            if (viewId === 'view-extra') renderAchievements();
        }

        function updateThickSlider(fillId, labelId, val, unit) {
            const label = document.getElementById(labelId);
            const fill = document.getElementById(fillId);
            if (label) label.textContent = `${val}${unit}`;
            if (fill) {
                const input = fill.nextElementSibling;
                if (input) {
                    const min = parseFloat(input.min) || 0;
                    const max = parseFloat(input.max) || 100;
                    const percent = ((val - min) / (max - min)) * 100;
                    fill.style.width = `${percent}%`;
                }
            }
        }

        const themeBtn = document.getElementById('theme-btn');
        function setTheme(isDark) {
            document.body.classList.toggle('dark-mode', isDark);
            themeBtn.querySelector('span').textContent = isDark ? 'dark_mode' : 'light_mode';
        }

        themeBtn.addEventListener('click', () => {
            setTheme(!document.body.classList.contains('dark-mode'));
        });

        function sleep(ms) {
            return new Promise(resolve => setTimeout(resolve, ms));
        }

        window.onload = () => {
            updateResourceUI();
            renderStageChips();
            loadStageData();
            renderGallery();
            renderUpgradeList();
            renderAchievements();
            updateThickSlider('slider-time-fill', 'val-time', 4.0, '秒');
        };
    </script>
</body>
</html>

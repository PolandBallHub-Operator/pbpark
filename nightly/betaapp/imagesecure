<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1.0, user-scalable=no">
    <title>Image tracking checker Comply policy</title>

    <!-- Google Fonts & Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">

    <style>
        :root {
            --accent-primary: #3381FF;
            --accent-active: #1A5FCC;
            
            --ptz-theme-name: "Default Blue PTZ";
            --ptz-card-radius: 24px;
            --ptz-slider-height: 16px;
            --ptz-toggle-width: 54px;
            --ptz-toggle-height: 30px;
            --ptz-toggle-knob-radius: 50%;
            --ptz-toggle-knob-width: 22px;

            /* Light Mode ベースカラー */
            --bg-base: #F7F7F7;
            --glass-bg: #FFFFFF;
            --text-main: #000000;
            --text-sub: #666666;
            --bg-secondary: #EEEEEE;
            --nav-bg: #FFFFFF;
            --nav-icon-active: #000000;
            
            --m3-easing: cubic-bezier(0.32, 0.72, 0, 1);
            --transition-smooth: 0.35s var(--m3-easing);
            --card-padding: 24px;
        }

        /* ダークモード */
        .dark-mode {
            --bg-base: #121212;
            --glass-bg: #1E1E1E;
            --text-main: #FFFFFF;
            --text-sub: #A1A1A6;
            --bg-secondary: #2C2C2E;
            --nav-bg: #1E1E1E;
            --nav-icon-active: #FFFFFF;
        }

        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Plus Jakarta Sans', 'Noto Sans JP', sans-serif;
            background-color: var(--bg-base);
            color: var(--text-main);
            transition: background-color var(--transition-smooth), color var(--transition-smooth);
            overflow: hidden;
            height: 100vh;
            width: 100vw;
        }

        #app-viewport {
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        header {
            height: 64px;
            padding: 0 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--glass-bg);
            transition: background-color var(--transition-smooth);
            position: relative;
            flex-shrink: 0;
        }
        .logo {
            font-weight: 700;
            font-size: 17px;
            letter-spacing: -0.5px;
            color: var(--text-main);
            text-align: center;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .theme-toggle {
            position: absolute;
            right: 24px;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: none;
            background: var(--bg-secondary);
            color: var(--text-main);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background var(--transition-smooth), transform 0.2s;
        }
        .theme-toggle:active {
            transform: scale(0.9);
        }

        main {
            flex-grow: 1;
            overflow-y: auto;
            padding: 24px 20px 100px;
            max-width: 720px;
            width: 100%;
            margin: 0 auto;
            -webkit-overflow-scrolling: touch;
        }

        .glass-card {
            background: var(--glass-bg);
            border-radius: var(--ptz-card-radius);
            padding: var(--card-padding);
            margin-bottom: 20px;
            box-shadow: none !important;
            border: none !important;
            transition: background-color var(--transition-smooth), border-radius var(--transition-smooth);
        }

        h2 { 
            font-size: 18px; 
            margin-top: 0; 
            margin-bottom: 12px;
            font-weight: 700; 
            letter-spacing: -0.3px;
        }
        p {
            font-size: 13.5px;
            line-height: 1.5;
            margin-top: 0;
            margin-bottom: 16px;
            color: var(--text-sub);
        }

        /* リストコンポーネント */
        .custom-list {
            display: flex;
            flex-direction: column;
            gap: 2px;
            margin-bottom: 16px;
        }
        .list-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 4px;
            border-bottom: 1px solid var(--bg-secondary);
        }
        .list-item:last-child {
            border-bottom: none;
        }
        .list-item-title {
            font-weight: 600;
            font-size: 14px;
        }
        .list-item-desc {
            font-size: 12px;
            color: var(--text-sub);
            margin-top: 2px;
        }

        /* スライダー */
        .slider-wrapper {
            margin: 16px 0;
        }
        .slider-label-row {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
        }
        .thick-slider-container {
            position: relative;
            width: 100%;
            height: var(--ptz-slider-height);
            background: var(--bg-secondary);
            border-radius: calc(var(--ptz-slider-height) / 2);
            overflow: hidden;
            cursor: pointer;
            transition: height var(--transition-smooth);
        }
        .thick-slider-fill {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            width: 50%;
            background: var(--accent-primary);
            transition: background-color var(--transition-smooth), width 0.1s ease-out;
        }
        .thick-slider-input {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer;
            margin: 0;
        }

        /* ボタン */
        .ai-btn {
            border: none;
            outline: none;
            padding: 12px 24px;
            border-radius: 14px;
            font-weight: 600;
            font-size: 14px;
            color: white;
            cursor: pointer;
            background: var(--accent-primary);
            transition: transform 0.2s, background-color var(--transition-smooth);
            display: inline-flex;
            align-items: center;
            gap: 8px;
            justify-content: center;
        }
        .ai-btn:hover {
            transform: scale(1.02);
        }
        .ai-btn:active {
            background: var(--accent-active);
            transform: scale(0.96);
        }
        .ai-btn-secondary {
            background: var(--bg-secondary);
            color: var(--text-main);
        }

        /* 下付きナビゲーションバー */
        .bottom-nav-container {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 72px;
            background: var(--nav-bg);
            border-top: 1px solid var(--bg-secondary);
            z-index: 500;
            display: flex;
            justify-content: space-around;
            align-items: center;
            padding-bottom: env(safe-area-inset-bottom);
            transition: background-color var(--transition-smooth), border-color var(--transition-smooth);
        }
        .nav-item {
            flex: 1;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: var(--text-sub);
            transition: color 0.25s var(--m3-easing);
            position: relative;
            gap: 4px;
        }
        .nav-item span.material-symbols-outlined {
            font-size: 24px;
            font-variation-settings: 'FILL' 0, 'wght' 400;
            transition: font-variation-settings 0.2s, color 0.2s;
        }
        .nav-label {
            font-size: 11px;
            font-weight: 600;
        }
        .nav-item.active {
            color: var(--nav-icon-active);
        }
        .nav-item.active span.material-symbols-outlined {
            font-variation-settings: 'FILL' 1, 'wght' 700;
        }

        .view {
            display: none;
        }
        .view.active {
            display: block;
            animation: viewIn 0.3s var(--m3-easing);
        }
        @keyframes viewIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ドロップゾーン */
        .ptz-dropzone {
            border: 2px dashed var(--text-sub);
            border-radius: var(--ptz-card-radius);
            padding: 24px;
            text-align: center;
            cursor: pointer;
            background: rgba(0, 0, 0, 0.02);
            transition: background 0.2s, border-color 0.2s;
            margin-bottom: 16px;
        }
        .dark-mode .ptz-dropzone {
            background: rgba(255, 255, 255, 0.02);
        }
        .ptz-dropzone:hover {
            background: rgba(51, 129, 255, 0.05);
            border-color: var(--accent-primary);
        }

        /* トースト通知 */
        .toast {
            position: fixed;
            bottom: 84px;
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            background: var(--text-main);
            color: var(--glass-bg);
            padding: 10px 20px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 600;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s var(--m3-easing);
            z-index: 2000;
        }
        .toast.active {
            opacity: 1;
            visibility: visible;
            transform: translateX(-50%) translateY(0);
        }

        /* ダイアログ */
        .dialog-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 1000; display: flex; align-items: center; justify-content: center;
            opacity: 0; visibility: hidden; transition: all 0.3s var(--m3-easing);
        }
        .dialog-overlay.active { opacity: 1; visibility: visible; }
        .glass-dialog {
            background: var(--glass-bg);
            border-radius: var(--ptz-card-radius);
            padding: 24px; max-width: 380px; width: 90%; text-align: center;
            transform: scale(0.9) translateY(20px); transition: all 0.4s var(--m3-easing);
        }
        .dialog-overlay.active .glass-dialog { transform: scale(1) translateY(0); }

        .badge {
            background: var(--accent-primary);
            color: white;
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 700;
            display: inline-block;
        }
        .badge-warning {
            background: #FF9500;
        }
        .badge-danger {
            background: #FF3B30;
        }
        .badge-success {
            background: #34C759;
        }

        /* アプリ用カスタム要素 */
        .germany-ball-header {
            display: flex;
            align-items: center;
            gap: 16px;
        }
        .germany-ball-img {
            width: 72px;
            height: 72px;
            object-fit: contain;
            flex-shrink: 0;
        }
        .speech-bubble {
            font-size: 13.5px;
            font-weight: 700;
            color: var(--text-main);
            line-height: 1.4;
        }
        .img-preview {
            max-width: 100%;
            max-height: 240px;
            border-radius: 12px;
            display: block;
            margin: 12px auto;
            object-fit: contain;
        }

        .policy-tag {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 11px;
            font-weight: 700;
            color: var(--accent-primary);
            background: rgba(51, 129, 255, 0.1);
            padding: 4px 10px;
            border-radius: 8px;
            margin-bottom: 8px;
        }
    </style>
</head>
<body>

    <div id="app-viewport">
        <!-- HEADER -->
        <header>
            <div class="logo">
                <span class="material-symbols-outlined">verified_user</span>
                Image Tracking Checker
            </div>
            <button class="theme-toggle" id="theme-btn" title="テーマ切り替え">
                <span class="material-symbols-outlined">light_mode</span>
            </button>
        </header>

        <!-- MAIN CONTENT AREA -->
        <main>
            <!-- 1. HOME & CHECKER VIEW -->
            <section id="view-home" class="view active">
                <!-- Germany Ball Header Section -->
                <div class="glass-card">
                    <div class="germany-ball-header">
                        <img src="https://raw.githubusercontent.com/PolandBallHub-Operator/pbimagesPublic/refs/heads/main/newballs/germany/hmm.png" alt="GermanyBall" class="germany-ball-img">
                        <div>
                            <div class="speech-bubble">「SNSに画像をあげたら、追跡されちゃう！？」</div>
                            <div style="font-size: 12px; color: var(--text-sub); margin-top: 4px;">
                                GPS位置情報やC2PA（生成AI・デジタル証明タグ）の有無を判定し、個人情報保護ポリシーに準拠して完全削除します。
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Upload Section -->
                <div class="glass-card">
                    <h2>画像を解析・セキュリティチェック</h2>
                    <p>チェックしたい画像を選択してください。本アプリはセキュリティポリシーに基づき、ローカルブラウザ内のみで解析を行います。</p>

                    <div class="ptz-dropzone" id="main-dropzone" onclick="triggerMainFile()">
                        <span class="material-symbols-outlined" style="font-size: 40px; color: var(--accent-primary); margin-bottom: 8px;">add_photo_alternate</span>
                        <div style="font-weight: 700; font-size: 14px;">ここに画像をドロップ、またはタップして選択</div>
                        <div style="font-size: 12px; color: var(--text-sub); margin-top: 4px;">JPEG, PNG, WebP に対応</div>
                        <input type="file" id="main-file-input" accept="image/jpeg,image/png,image/webp" style="display: none;" onchange="handleMainImage(event)">
                    </div>

                    <div style="text-align: center; margin-bottom: 12px;">
                        <button class="ai-btn ai-btn-secondary" onclick="loadSampleImage()">
                            <span class="material-symbols-outlined">download_for_offline</span>
                            GermanyBallサンプル画像を試す
                        </button>
                    </div>

                    <div id="image-preview-container" style="display: none;">
                        <img id="main-preview-img" class="img-preview" alt="Preview">
                    </div>
                </div>

                <!-- Analysis Results Section -->
                <div class="glass-card" id="analysis-card" style="display: none;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <h2>解析ステータス</h2>
                        <span class="badge" id="risk-badge">安全</span>
                    </div>

                    <div class="custom-list">
                        <div class="list-item">
                            <div>
                                <div class="list-item-title">C2PA / 改ざん防止・生成AI追跡タグ</div>
                                <div class="list-item-desc" id="c2pa-desc">検出結果をチェック中...</div>
                            </div>
                            <span class="badge badge-success" id="c2pa-badge">未検出</span>
                        </div>

                        <div class="list-item">
                            <div>
                                <div class="list-item-title">GPS 位置情報 (Exif GPS)</div>
                                <div class="list-item-desc" id="gps-desc">検出結果をチェック中...</div>
                            </div>
                            <span class="badge badge-success" id="gps-badge">未検出</span>
                        </div>

                        <div class="list-item">
                            <div>
                                <div class="list-item-title">カメラ・機器情報 (EXIF)</div>
                                <div class="list-item-desc" id="exif-desc">検出結果をチェック中...</div>
                            </div>
                            <span class="badge badge-success" id="exif-badge">未検出</span>
                        </div>
                    </div>

                    <div style="margin-top: 16px; display: flex; flex-direction: column; gap: 8px;">
                        <button class="ai-btn" onclick="stripMetadataAction()">
                            <span class="material-symbols-outlined">cleaning_services</span>
                            追跡タグ・位置情報を完全除去（安全クレンジング）
                        </button>
                    </div>
                </div>
            </section>

            <!-- 2. POLICY & KNOWLEDGE VIEW -->
            <section id="view-info" class="view">
                <div class="glass-card">
                    <div class="policy-tag">
                        <span class="material-symbols-outlined" style="font-size: 14px;">policy</span>
                        Comply Policy Standard
                    </div>
                    <h2>プライバシー・コンプライアンス方針</h2>
                    <p>当アプリケーション（Comply Policy準拠版）は、ユーザーのプライバシー保護とメタデータの不正改ざん防止のため以下の設計原則に基づいています。</p>
                    
                    <div class="custom-list">
                        <div class="list-item">
                            <div>
                                <div class="list-item-title">1. メタデータ偽装・移植機能の廃止</div>
                                <div class="list-item-desc">第三者のC2PA証明署名や偽のGPS座標を他画像へ移植・改ざんする機能を排除し、健全なデジタル権利保護に準拠しています。</div>
                            </div>
                        </div>
                        <div class="list-item">
                            <div>
                                <div class="list-item-title">2. ローカル完結型処理 (Zero Server Load)</div>
                                <div class="list-item-desc">読み込んだ画像データは外部サーバーへ一切送信されません。全ての解析・消去処理はお使いの端末ブラウザ内で完了します。</div>
                            </div>
                        </div>
                        <div class="list-item">
                            <div>
                                <div class="list-item-title">3. ピクセル純粋再描画による完全削除</div>
                                <div class="list-item-desc">画素情報のみをキャンバスに抽出し直すことで、ステガノグラフィや未定義メタデータを含む潜在的追跡コードを100%遮断します。</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="glass-card">
                    <h2>クレンジング設定</h2>
                    <p>追跡除去後の画像保存クオリティを設定できます。</p>

                    <div class="slider-wrapper">
                        <div class="slider-label-row">
                            <span>保存画質 (JPEG/WebP)</span>
                            <span id="val-quality">92%</span>
                        </div>
                        <div class="thick-slider-container">
                            <div class="thick-slider-fill" id="slider-quality-fill" style="width: 92%;"></div>
                            <input type="range" class="thick-slider-input" min="50" max="100" value="92" oninput="updateThickSlider('slider-quality-fill', 'val-quality', this.value, '%')">
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <!-- BOTTOM NAVIGATION -->
        <div class="bottom-nav-container">
            <div class="nav-item active" data-view="view-home" onclick="switchView('view-home')">
                <span class="material-symbols-outlined">search</span>
                <span class="nav-label">解析・除去</span>
            </div>
            <div class="nav-item" data-view="view-info" onclick="switchView('view-info')">
                <span class="material-symbols-outlined">policy</span>
                <span class="nav-label">Comply Policy</span>
            </div>
        </div>
    </div>

    <!-- DIALOG OVERLAY -->
    <div class="dialog-overlay" id="main-dialog">
        <div class="glass-dialog">
            <span class="material-symbols-outlined" style="font-size: 44px; color: var(--accent-primary);">verified</span>
            <h2 style="margin-top: 12px;" id="dialog-title">完了</h2>
            <p style="margin-bottom: 20px;" id="dialog-body">処理が正常に実行されました。</p>
            <button class="ai-btn" style="width: 100%; justify-content: center;" onclick="closeDialog()">閉じる</button>
        </div>
    </div>

    <!-- TOAST MESSAGE -->
    <div class="toast" id="toast-message">処理が完了しました</div>

    <script>
        /**
         * Image Tracking Checker Core Script (Comply Policy Standard)
         */

        const toast = document.getElementById('toast-message');
        const themeBtn = document.getElementById('theme-btn');
        const themeIcon = themeBtn.querySelector('span');

        let currentImageArrayBuffer = null;
        let currentImageFile = null;
        let detectedState = {
            hasC2PA: false,
            hasGPS: false,
            hasExif: false
        };

        // UI View Switch
        const navItems = document.querySelectorAll('.nav-item');
        const views = document.querySelectorAll('.view');

        function switchView(viewId) {
            navItems.forEach(n => {
                n.classList.remove('active');
                if (n.getAttribute('data-view') === viewId) {
                    n.classList.add('active');
                }
            });

            views.forEach(v => {
                v.classList.remove('active');
                if (v.id === viewId) {
                    v.classList.add('active');
                }
            });
        }

        // Theme Setup
        function setTheme(isDark) {
            document.body.classList.toggle('dark-mode', isDark);
            themeIcon.textContent = isDark ? 'dark_mode' : 'light_mode';
        }

        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
        setTheme(prefersDark.matches);
        themeBtn.addEventListener('click', () => {
            setTheme(!document.body.classList.contains('dark-mode'));
        });

        // Toast Helper
        function showToast(msg) {
            toast.textContent = msg;
            toast.classList.add('active');
            setTimeout(() => {
                toast.classList.remove('active');
            }, 2300);
        }

        // Dialog Helper
        function openDialog(title, body) {
            document.getElementById('dialog-title').textContent = title;
            document.getElementById('dialog-body').textContent = body;
            document.getElementById('main-dialog').classList.add('active');
        }
        function closeDialog() {
            document.getElementById('main-dialog').classList.remove('active');
        }

        // Slider Helper
        function updateThickSlider(fillId, labelId, val, unit) {
            const label = document.getElementById(labelId);
            const fill = document.getElementById(fillId);
            if (label) label.textContent = `${val}${unit}`;
            if (fill) {
                const input = fill.nextElementSibling;
                if (input) {
                    const min = parseFloat(input.min) || 0;
                    const max = parseFloat(input.max) || 100;
                    const percent = ((val - min) / (max - min)) * 100;
                    fill.style.width = `${percent}%`;
                }
            }
        }

        // --- 1. Main File Load & Detection ---
        function triggerMainFile() {
            document.getElementById('main-file-input').click();
        }

        function handleMainImage(e) {
            const file = e.target.files[0];
            if (!file) return;
            processMainFile(file);
        }

        function processMainFile(file) {
            currentImageFile = file;
            const reader = new FileReader();
            reader.onload = function(evt) {
                currentImageArrayBuffer = evt.target.result;

                // Preview Image
                const blob = new Blob([currentImageArrayBuffer], { type: file.type });
                const url = URL.createObjectURL(blob);
                const imgEl = document.getElementById('main-preview-img');
                imgEl.src = url;
                document.getElementById('image-preview-container').style.display = 'block';

                // Run Analysis
                analyzeImageMetadata(currentImageArrayBuffer);
            };
            reader.readAsArrayBuffer(file);
        }

        // Load Germany Ball Sample
        async function loadSampleImage() {
            showToast("GermanyBallサンプル画像をロード中...");
            const targetUrl = "https://raw.githubusercontent.com/PolandBallHub-Operator/pbimagesPublic/refs/heads/main/newballs/germany/hmm.png";
            try {
                const response = await fetch(targetUrl);
                const blob = await response.blob();
                const file = new File([blob], "germany_hmm.png", { type: "image/png" });
                processMainFile(file);
            } catch (err) {
                showToast("サンプル画像の読み込みに失敗しました");
            }
        }

        // Binary Analysis Engine for EXIF, GPS & C2PA
        function analyzeImageMetadata(buffer) {
            const view = new DataView(buffer);
            const bytes = new Uint8Array(buffer);

            detectedState.hasC2PA = false;
            detectedState.hasGPS = false;
            detectedState.hasExif = false;

            // Search for String signatures (C2PA / JUMBF)
            const textDecoder = new TextDecoder('ascii');
            const fullStr = textDecoder.decode(bytes.slice(0, Math.min(bytes.length, 1000000)));

            if (fullStr.includes('c2pa') || fullStr.includes('jumb') || fullStr.includes('C2PA') || fullStr.includes('clm1')) {
                detectedState.hasC2PA = true;
            }

            // Check JPEG Markers
            if (bytes[0] === 0xFF && bytes[1] === 0xD8) {
                let offset = 2;
                while (offset < bytes.length) {
                    if (bytes[offset] !== 0xFF) break;
                    const marker = bytes[offset + 1];
                    
                    // APP1 Marker (Exif / GPS)
                    if (marker === 0xE1) {
                        detectedState.hasExif = true;
                        const header = textDecoder.decode(bytes.slice(offset + 4, offset + 8));
                        if (header === 'Exif') {
                            const exifStr = textDecoder.decode(bytes.slice(offset, offset + 2000));
                            if (exifStr.includes('GPS') || exifStr.includes('GPSInfo')) {
                                detectedState.hasGPS = true;
                            }
                        }
                    }
                    // APP11 or C2PA Segment
                    if (marker === 0xEB || marker === 0xEF) {
                        detectedState.hasC2PA = true;
                    }

                    if (marker === 0xDA) break; // SOS (Start of Scan)
                    const length = (bytes[offset + 2] << 8) + bytes[offset + 3];
                    offset += 2 + length;
                }
            } else if (bytes[0] === 0x89 && bytes[1] === 0x50) {
                // PNG Chunks Analysis
                if (fullStr.includes('eXIf') || fullStr.includes('tEXt') || fullStr.includes('iTXt')) {
                    detectedState.hasExif = true;
                }
                if (fullStr.includes('GPS')) {
                    detectedState.hasGPS = true;
                }
            }

            // Update UI Elements
            document.getElementById('analysis-card').style.display = 'block';

            const c2paBadge = document.getElementById('c2pa-badge');
            const c2paDesc = document.getElementById('c2pa-desc');
            if (detectedState.hasC2PA) {
                c2paBadge.textContent = "検出あり (警告)";
                c2paBadge.className = "badge badge-danger";
                c2paDesc.textContent = "C2PA / Content Credentials マニフェストが含まれています。";
            } else {
                c2paBadge.textContent = "未検出";
                c2paBadge.className = "badge badge-success";
                c2paDesc.textContent = "デジタル追跡署名タグは見つかりませんでした。";
            }

            const gpsBadge = document.getElementById('gps-badge');
            const gpsDesc = document.getElementById('gps-desc');
            if (detectedState.hasGPS) {
                gpsBadge.textContent = "検出あり (危険)";
                gpsBadge.className = "badge badge-danger";
                gpsDesc.textContent = "正確な撮影場所情報(緯度・経度)が含まれています！";
            } else {
                gpsBadge.textContent = "未検出";
                gpsBadge.className = "badge badge-success";
                gpsDesc.textContent = "GPS位置情報は埋め込まれていません。";
            }

            const exifBadge = document.getElementById('exif-badge');
            const exifDesc = document.getElementById('exif-desc');
            if (detectedState.hasExif) {
                exifBadge.textContent = "検出あり";
                exifBadge.className = "badge badge-warning";
                exifDesc.textContent = "カメラ機種情報や撮影日時が含まれています。";
            } else {
                exifBadge.textContent = "未検出";
                exifBadge.className = "badge badge-success";
                exifDesc.textContent = "カメラ・端末情報は含まれていません。";
            }

            const riskBadge = document.getElementById('risk-badge');
            if (detectedState.hasGPS || detectedState.hasC2PA) {
                riskBadge.textContent = "追跡リスクあり";
                riskBadge.className = "badge badge-danger";
            } else if (detectedState.hasExif) {
                riskBadge.textContent = "注意";
                riskBadge.className = "badge badge-warning";
            } else {
                riskBadge.textContent = "安全";
                riskBadge.className = "badge badge-success";
            }
        }

        // --- 2. Strip Metadata Action ---
        function stripMetadataAction() {
            if (!currentImageFile || !currentImageArrayBuffer) {
                showToast("画像が読み込まれていません");
                return;
            }

            showToast("安全なクレンジング処理を実行中...");

            // Re-render via Canvas to produce clean binary pixels
            const img = new Image();
            const blob = new Blob([currentImageArrayBuffer], { type: currentImageFile.type });
            const url = URL.createObjectURL(blob);

            img.onload = function() {
                const canvas = document.createElement('canvas');
                canvas.width = img.width;
                canvas.height = img.height;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0);

                const qualityVal = parseInt(document.getElementById('val-quality').textContent) / 100;
                
                canvas.toBlob((cleanBlob) => {
                    const downloadUrl = URL.createObjectURL(cleanBlob);
                    const a = document.createElement('a');
                    a.href = downloadUrl;
                    a.download = `cleansed_${currentImageFile.name || 'image.png'}`;
                    document.body.appendChild(a);
                    a.click();
                    a.remove();

                    openDialog("クレンジング完了！", "EXIF、GPS位置情報、C2PAタグを完全に消去した安全な画像をダウンロードしました。");
                }, currentImageFile.type || 'image/jpeg', qualityVal);
            };
            img.src = url;
        }

        // Dropzone Event Binding
        const dropzone = document.getElementById('main-dropzone');
        ['dragenter', 'dragover'].forEach(evtName => {
            dropzone.addEventListener(evtName, (e) => {
                e.preventDefault();
                dropzone.style.background = 'rgba(51, 129, 255, 0.1)';
            });
        });

        ['dragleave', 'drop'].forEach(evtName => {
            dropzone.addEventListener(evtName, (e) => {
                e.preventDefault();
                dropzone.style.background = 'rgba(0, 0, 0, 0.02)';
            });
        });

        dropzone.addEventListener('drop', (e) => {
            const file = e.dataTransfer.files[0];
            if (file) processMainFile(file);
        });

        // Initializer
        window.onload = () => {
            updateThickSlider('slider-quality-fill', 'val-quality', 92, '%');
        };
    </script>

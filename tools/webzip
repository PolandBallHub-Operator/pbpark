        </main>

        <!-- 下付き固定ナビゲーションバー -->
        <div class="bottom-nav-container">
            <div class="nav-item active" data-view="view-unzip" onclick="switchView('view-unzip')">
                <span class="material-symbols-outlined">unarchive</span>
                <span class="nav-label">解凍 (Unzip)</span>
            </div>
            <div class="nav-item" data-view="view-zip" onclick="switchView('view-zip')">
                <span class="material-symbols-outlined">folder_zip</span>
                <span class="nav-label">圧縮 (Create)</span>
            </div>
            <div class="nav-item" data-view="view-settings" onclick="switchView('view-settings')">
                <span class="material-symbols-outlined">tune</span>
                <span class="nav-label">USA / 設定</span>
            </div>
        </div>
    </div>

    <!-- カスタムダイアログ: 新規フォルダ作成 -->
    <div class="dialog-overlay" id="folder-dialog">
        <div class="glass-dialog">
            <span class="material-symbols-outlined" style="font-size: 40px; color: var(--accent-primary); margin-bottom: 8px;">create_new_folder</span>
            <h2 style="margin-top: 4px;">新規フォルダの作成</h2>
            <p style="margin-bottom: 12px; font-size: 12px;">カレントフォルダ内に新しくフォルダを作成します。</p>
            <div class="glass-input-wrapper">
                <input type="text" class="glass-input" id="folder-name-input" placeholder="フォルダ名 (例: images)">
            </div>
            <div style="display: flex; gap: 8px;">
                <button class="ai-btn ai-btn-secondary" style="flex: 1; justify-content: center;" onclick="closeFolderDialog()">キャンセル</button>
                <button class="ai-btn" style="flex: 1; justify-content: center;" onclick="confirmCreateFolder()">作成</button>
            </div>
        </div>
    </div>

    <!-- カスタムダイアログ: ようこそ -->
    <div class="dialog-overlay" id="main-dialog">
        <div class="glass-dialog">
            <img src="https://raw.githubusercontent.com/Polandballhub-Operator/pbimagesPublic/refs/heads/main/balls/usa/normal.png" alt="USA Mascot" style="width: 64px; height: 64px; margin-bottom: 8px;">
            <h2 style="margin-top: 4px;">We-Zip へようこそ！</h2>
            <p style="margin-bottom: 20px;">
                We-Zip は完全クライアントサイドで動作する高機能Web ZIPツールです。フォルダ階層構造の閲覧・作成、解凍、圧縮に完全対応しています。
            </p>
            <button class="ai-btn" style="width: 100%; justify-content: center;" onclick="closeDialog()">始める</button>
        </div>
    </div>

    <!-- トースト通知 -->
    <div class="toast" id="toast-message">メッセージ</div>

    <script>
        /**
         * We-Zip Application Core Script
         */

        const themeBtn = document.getElementById('theme-btn');
        const themeIcon = themeBtn.querySelector('span');
        const toast = document.getElementById('toast-message');
        const ptzCodeArea = document.getElementById('ptz-code-area');
        const jsonErrorMsg = document.getElementById('json-error-msg');

        // デフォルトPTZオブジェクト
        let currentPtz = {
            "themeName": "Default Blue PTZ",
            "accentColor": "#3381FF",
            "cardRadius": 24,
            "sliderHeight": 16,
            "toggleWidth": 54,
            "toggleHeight": 30,
            "toggleKnobRadius": 50,
            "toggleKnobWidth": 22,
            "blurIntensity": 0,
            "bgLight": "#F7F7F7",
            "bgDark": "#121212"
        };

        // プリセットデータ定義
        const presets = {
            default: {
                "themeName": "Default Blue PTZ",
                "accentColor": "#3381FF",
                "cardRadius": 24,
                "sliderHeight": 16,
                "toggleWidth": 54,
                "toggleHeight": 30,
                "toggleKnobRadius": 50,
                "toggleKnobWidth": 22,
                "blurIntensity": 0,
                "bgLight": "#F7F7F7",
                "bgDark": "#121212"
            },
            sharpPurple: {
                "themeName": "Sharp Purple PTZ",
                "accentColor": "#8B5CF6",
                "cardRadius": 0,
                "sliderHeight": 12,
                "toggleWidth": 50,
                "toggleHeight": 26,
                "toggleKnobRadius": 0,
                "toggleKnobWidth": 18,
                "blurIntensity": 0,
                "bgLight": "#FFFFFF",
                "bgDark": "#1C1C1E"
            },
            chunkyRose: {
                "themeName": "Chunky Rose PTZ",
                "accentColor": "#E11D48",
                "cardRadius": 32,
                "sliderHeight": 24,
                "toggleWidth": 64,
                "toggleHeight": 36,
                "toggleKnobRadius": 50,
                "toggleKnobWidth": 28,
                "blurIntensity": 0,
                "bgLight": "#FFF1F2",
                "bgDark": "#1A0B0E"
            },
            minimalGray: {
                "themeName": "Minimal Monochrome PTZ",
                "accentColor": "#444444",
                "cardRadius": 12,
                "sliderHeight": 14,
                "toggleWidth": 46,
                "toggleHeight": 24,
                "toggleKnobRadius": 50,
                "toggleKnobWidth": 16,
                "blurIntensity": 0,
                "bgLight": "#F3F4F6",
                "bgDark": "#0F0F10"
            }
        };

        // --- PTZ適用のコア関数 ---
        function applyPtz(ptz) {
            currentPtz = { ...currentPtz, ...ptz };

            const root = document.documentElement;
            root.style.setProperty('--accent-primary', currentPtz.accentColor);
            root.style.setProperty('--accent-active', adjustColorBrightness(currentPtz.accentColor, -15));
            root.style.setProperty('--ptz-card-radius', `${currentPtz.cardRadius}px`);
            root.style.setProperty('--ptz-slider-height', `${currentPtz.sliderHeight}px`);
            root.style.setProperty('--ptz-toggle-width', `${currentPtz.toggleWidth}px`);
            root.style.setProperty('--ptz-toggle-height', `${currentPtz.toggleHeight}px`);
            root.style.setProperty('--ptz-toggle-knob-radius', isNaN(currentPtz.toggleKnobRadius) ? currentPtz.toggleKnobRadius : `${currentPtz.toggleKnobRadius}%`);
            root.style.setProperty('--ptz-toggle-knob-width', `${currentPtz.toggleKnobWidth}px`);
            
            root.style.setProperty('--bg-base', document.body.classList.contains('dark-mode') ? currentPtz.bgDark : currentPtz.bgLight);

            const badge = document.getElementById('current-theme-badge');
            if (badge) badge.textContent = currentPtz.themeName || "PTZ Config";

            ptzCodeArea.value = JSON.stringify(currentPtz, null, 2);
        }

        function adjustColorBrightness(hex, percent) {
            let R = parseInt(hex.substring(1, 3), 16);
            let G = parseInt(hex.substring(3, 5), 16);
            let B = parseInt(hex.substring(5, 7), 16);
            R = parseInt(R * (100 + percent) / 100);
            G = parseInt(G * (100 + percent) / 100);
            B = parseInt(B * (100 + percent) / 100);
            R = (R < 255) ? R : 255; G = (G < 255) ? G : 255; B = (B < 255) ? B : 255;
            const rHex = ((R.toString(16).length == 1) ? "0" + R.toString(16) : R.toString(16));
            const gHex = ((G.toString(16).length == 1) ? "0" + G.toString(16) : G.toString(16));
            const bHex = ((B.toString(16).length == 1) ? "0" + B.toString(16) : B.toString(16));
            return "#" + rHex + gHex + bHex;
        }

        function validateAndApplyJson(textVal) {
            try {
                const parsed = JSON.parse(textVal);
                jsonErrorMsg.style.display = 'none';
                applyPtz(parsed);
                return true;
            } catch (e) {
                jsonErrorMsg.textContent = `JSON構文エラー: ${e.message}`;
                jsonErrorMsg.style.display = 'block';
                return false;
            }
        }

        function applyJsonFromTextArea() {
            if (validateAndApplyJson(ptzCodeArea.value)) {
                showToast('PTZ.json 変更が適用されました');
            } else {
                showToast('エラー箇所を修正してください');
            }
        }

        function loadPreset(key) {
            if (presets[key]) {
                applyPtz(presets[key]);
                showToast(`プリセット [${presets[key].themeName}] をロードしました`);
            }
        }

        // --- ZIP 展開（解凍）階層閲覧機能 ---
        let extractedZipEntries = {};
        let currentUnzipPath = ""; // 例: "folder1/subfolder/"

        function handleUnzipSelect(event) {
            const file = event.target.files[0];
            if (file) processZipFile(file);
        }

        function processZipFile(file) {
            showToast('ZIPファイルを解析中...');
            JSZip.loadAsync(file).then((zip) => {
                extractedZipEntries = zip.files;
                currentUnzipPath = "";
                document.getElementById('unzip-results-card').style.display = 'block';
                document.getElementById('unzip-archive-title').textContent = file.name;
                renderUnzipDirectory();
                showToast('ZIPを展開しました');
            }).catch((err) => {
                showToast('ZIPの読み込みに失敗: ' + err.message);
            });
        }

        // カレントパスのディレクトリ一覧を描画
        function renderUnzipDirectory() {
            const listContainer = document.getElementById('unzip-file-list');
            const countLabel = document.getElementById('unzip-file-count');
            const breadcrumbBar = document.getElementById('unzip-breadcrumb');

            listContainer.innerHTML = '';
            
            // 1. パンくずリスト構築
            renderBreadcrumb(breadcrumbBar, currentUnzipPath, (path) => {
                currentUnzipPath = path;
                renderUnzipDirectory();
            });

            // 2. カレントパス直下のファイル・フォルダのリストアップ
            const folders = new Set();
            const files = [];

            Object.keys(extractedZipEntries).forEach((fullPath) => {
                if (!fullPath.startsWith(currentUnzipPath) || fullPath === currentUnzipPath) return;

                const relativePath = fullPath.slice(currentUnzipPath.length);
                const parts = relativePath.split('/').filter(p => p.length > 0);

                if (parts.length > 1 || extractedZipEntries[fullPath].dir) {
                    // フォルダ要素
                    folders.add(parts[0]);
                } else if (parts.length === 1) {
                    // ファイル要素
                    files.push({
                        name: parts[0],
                        fullPath: fullPath,
                        entry: extractedZipEntries[fullPath]
                    });
                }
            });

            const folderList = Array.from(folders);
            countLabel.textContent = `${folderList.length} 個のフォルダ, ${files.length} 個のファイル`;

            if (folderList.length === 0 && files.length === 0) {
                listContainer.innerHTML = `<div class="list-item"><div class="list-item-title" style="color:var(--text-sub);">このフォルダは空です</div></div>`;
                return;
            }

            // フォルダ項目の表示
            folderList.forEach((folderName) => {
                const itemEl = document.createElement('div');
                itemEl.className = 'list-item clickable';
                itemEl.onclick = () => {
                    currentUnzipPath += folderName + "/";
                    renderUnzipDirectory();
                };
                itemEl.innerHTML = `
                    <div style="display: flex; align-items: center; gap: 10px; overflow: hidden;">
                        <span class="material-symbols-outlined" style="color: var(--accent-primary); flex-shrink: 0;">folder</span>
                        <div style="overflow: hidden;">
                            <div class="list-item-title">${escapeHtml(folderName)}</div>
                            <div class="list-item-desc">フォルダ</div>
                        </div>
                    </div>
                    <span class="material-symbols-outlined" style="color: var(--text-sub);">chevron_right</span>
                `;
                listContainer.appendChild(itemEl);
            });

            // ファイル項目の表示
            files.forEach((fileItem) => {
                const itemEl = document.createElement('div');
                itemEl.className = 'list-item';
                const formattedSize = formatBytes(fileItem.entry._data ? fileItem.entry._data.uncompressedSize : 0);

                itemEl.innerHTML = `
                    <div style="display: flex; align-items: center; gap: 10px; overflow: hidden;">
                        <span class="material-symbols-outlined" style="color: var(--accent-primary); flex-shrink: 0;">description</span>
                        <div style="overflow: hidden;">
                            <div class="list-item-title">${escapeHtml(fileItem.name)}</div>
                            <div class="list-item-desc">${formattedSize}</div>
                        </div>
                    </div>
                    <button class="icon-btn-small" onclick="downloadSingleExtractedFile('${escapeHtml(fileItem.fullPath)}')">
                        <span class="material-symbols-outlined">download</span>
                    </button>
                `;
                listContainer.appendChild(itemEl);
            });
        }

        function downloadSingleExtractedFile(fullPath) {
            const zipEntry = extractedZipEntries[fullPath];
            if (!zipEntry) return;

            zipEntry.async('blob').then((content) => {
                saveAs(content, fullPath.split('/').pop() || fullPath);
                showToast(`ダウンロード完了: ${fullPath.split('/').pop()}`);
            });
        }

        function downloadAllExtractedFiles() {
            const keys = Object.keys(extractedZipEntries);
            if (keys.length === 0) return;

            showToast('一括ダウンロードを準備中...');
            keys.forEach((filename) => {
                const entry = extractedZipEntries[filename];
                if (!entry.dir) {
                    entry.async('blob').then((blob) => {
                        saveAs(blob, filename.split('/').pop() || filename);
                    });
                }
            });
        }

        // --- ZIP 圧縮・作成階層マネージャー ---
        // items: [{ path: "folder/file.txt", content: Blob|File|String, isText: boolean, isFolder: boolean }]
        let filesToZip = [];
        let currentCreatePath = ""; // カレント作成フォルダパス例: "documents/"
        let currentCompressLevel = 6;

        function updateCompressLevel(val) {
            currentCompressLevel = parseInt(val, 10);
            const fill = document.getElementById('slider-compress-fill');
            const label = document.getElementById('val-compress-level');
            
            const percent = (currentCompressLevel / 9) * 100;
            fill.style.width = `${percent}%`;
            
            let desc = '標準';
            if (currentCompressLevel === 0) desc = '無圧縮';
            else if (currentCompressLevel < 4) desc = '高速';
            else if (currentCompressLevel > 7) desc = '最大圧縮';

            label.textContent = `${currentCompressLevel} (${desc})`;
        }

        function handleFilesToZipSelect(event) {
            const files = event.target.files;
            if (!files.length) return;

            for (let i = 0; i < files.length; i++) {
                const targetPath = currentCreatePath + files[i].name;
                filesToZip.push({
                    path: targetPath,
                    name: files[i].name,
                    content: files[i],
                    size: files[i].size,
                    isText: false,
                    isFolder: false
                });
            }
            renderZipItemsList();
            showToast(`${files.length} 個のファイルを追加しました`);
            event.target.value = '';
        }

        // 新規フォルダ作成ダイアログ制御
        function openCreateFolderDialog() {
            document.getElementById('folder-name-input').value = '';
            document.getElementById('folder-dialog').classList.add('active');
        }
        function closeFolderDialog() {
            document.getElementById('folder-dialog').classList.remove('active');
        }

        function confirmCreateFolder() {
            let folderName = document.getElementById('folder-name-input').value.trim();
            if (!folderName) {
                showToast('フォルダ名を入力してください');
                return;
            }
            folderName = folderName.replace(/[\/\\]/g, '_'); // セパレータ文字置換
            const folderPath = currentCreatePath + folderName + "/";

            // 重複チェック
            const exists = filesToZip.some(item => item.path === folderPath);
            if (!exists) {
                filesToZip.push({
                    path: folderPath,
                    name: folderName,
                    content: null,
                    size: 0,
                    isText: false,
                    isFolder: true
                });
            }
            closeFolderDialog();
            renderZipItemsList();
            showToast(`フォルダ「${folderName}」を作成しました`);
        }

        function addTextFileToZipList() {
            const nameInput = document.getElementById('new-text-name');
            const contentInput = document.getElementById('new-text-content');

            let name = nameInput.value.trim();
            const content = contentInput.value;

            if (!name) name = `text_${Date.now()}.txt`;
            if (!name.includes('.')) name += '.txt';

            const targetPath = currentCreatePath + name;

            filesToZip.push({
                path: targetPath,
                name: name,
                content: content,
                size: new Blob([content]).size,
                isText: true,
                isFolder: false
            });

            renderZipItemsList();
            nameInput.value = '';
            contentInput.value = '';
            showToast(`テキスト「${name}」を追加しました`);
        }

        function removeItemFromZipList(path) {
            // フォルダの場合は配下アイテムも一緒に削除
            filesToZip = filesToZip.filter(item => item.path !== path && !item.path.startsWith(path));
            renderZipItemsList();
            showToast('削除しました');
        }

        function clearZipList() {
            filesToZip = [];
            currentCreatePath = "";
            renderZipItemsList();
            showToast('リストをクリアしました');
        }

        // 作成中のフォルダー内容リストを描画
        function renderZipItemsList() {
            const container = document.getElementById('zip-items-list');
            const breadcrumbBar = document.getElementById('create-breadcrumb');
            container.innerHTML = '';

            // パンくずリスト更新
            renderBreadcrumb(breadcrumbBar, currentCreatePath, (path) => {
                currentCreatePath = path;
                renderZipItemsList();
            });

            // カレントパス直下のフォルダ・ファイルの抽出
            const folders = new Set();
            const files = [];

            filesToZip.forEach((item) => {
                if (!item.path.startsWith(currentCreatePath) || item.path === currentCreatePath) return;

                const relativePath = item.path.slice(currentCreatePath.length);
                const parts = relativePath.split('/').filter(p => p.length > 0);

                if (item.isFolder && parts.length === 1) {
                    folders.add(parts[0]);
                } else if (parts.length > 1) {
                    folders.add(parts[0]);
                } else if (parts.length === 1 && !item.isFolder) {
                    files.push(item);
                }
            });

            const folderList = Array.from(folders);

            if (folderList.length === 0 && files.length === 0) {
                container.innerHTML = `
                    <div class="list-item">
                        <div>
                            <div class="list-item-title" style="color: var(--text-sub);">このフォルダにはアイテムがありません</div>
                        </div>
                    </div>
                `;
                return;
            }

            // フォルダの描画
            folderList.forEach((folderName) => {
                const folderPath = currentCreatePath + folderName + "/";
                const itemEl = document.createElement('div');
                itemEl.className = 'list-item clickable';
                itemEl.innerHTML = `
                    <div style="display: flex; align-items: center; gap: 10px; overflow: hidden; flex: 1;" onclick="navigateToCreateFolder('${folderPath}')">
                        <span class="material-symbols-outlined" style="color: var(--accent-primary); flex-shrink: 0;">folder</span>
                        <div style="overflow: hidden;">
                            <div class="list-item-title">${escapeHtml(folderName)}</div>
                            <div class="list-item-desc">フォルダ</div>
                        </div>
                    </div>
                    <button class="icon-btn-small" onclick="removeItemFromZipList('${folderPath}')">
                        <span class="material-symbols-outlined" style="color:#FF3B30;">delete</span>
                    </button>
                `;
                container.appendChild(itemEl);
            });

            // ファイルの描画
            files.forEach((item) => {
                const itemEl = document.createElement('div');
                itemEl.className = 'list-item';
                itemEl.innerHTML = `
                    <div style="display: flex; align-items: center; gap: 10px; overflow: hidden;">
                        <span class="material-symbols-outlined" style="color: var(--accent-primary); flex-shrink: 0;">
                            ${item.isText ? 'article' : 'file_present'}
                        </span>
                        <div style="overflow: hidden;">
                            <div class="list-item-title">${escapeHtml(item.name)}</div>
                            <div class="list-item-desc">${formatBytes(item.size)}</div>
                        </div>
                    </div>
                    <button class="icon-btn-small" onclick="removeItemFromZipList('${item.path}')">
                        <span class="material-symbols-outlined" style="color:#FF3B30;">delete</span>
                    </button>
                `;
                container.appendChild(itemEl);
            });
        }

        function navigateToCreateFolder(path) {
            currentCreatePath = path;
            renderZipItemsList();
        }

        // 共通パンくず生成関数
        function renderBreadcrumb(container, fullPath, onNavigate) {
            container.innerHTML = '';

            const rootItem = document.createElement('div');
            rootItem.className = `breadcrumb-item ${fullPath === "" ? "active" : ""}`;
            rootItem.innerHTML = `<span class="material-symbols-outlined" style="font-size:16px;">home</span> ルート`;
            if (fullPath !== "") {
                rootItem.onclick = () => onNavigate("");
            }
            container.appendChild(rootItem);

            if (fullPath === "") return;

            const parts = fullPath.split('/').filter(p => p.length > 0);
            let accumulated = "";

            parts.forEach((part, idx) => {
                accumulated += part + "/";
                const pathSnap = accumulated;

                const sep = document.createElement('span');
                sep.className = 'breadcrumb-separator';
                sep.textContent = '/';
                container.appendChild(sep);

                const isLast = idx === parts.length - 1;
                const item = document.createElement('div');
                item.className = `breadcrumb-item ${isLast ? "active" : ""}`;
                item.textContent = part;

                if (!isLast) {
                    item.onclick = () => onNavigate(pathSnap);
                }
                container.appendChild(item);
            });
        }

        function buildAndDownloadZip() {
            if (filesToZip.length === 0) {
                showToast('圧縮するファイルまたはフォルダを追加してください');
                return;
            }

            let zipFilename = document.getElementById('zip-filename-input').value.trim();
            if (!zipFilename) zipFilename = 'Archive.zip';
            if (!zipFilename.endsWith('.zip')) zipFilename += '.zip';

            const zip = new JSZip();

            filesToZip.forEach((item) => {
                if (item.isFolder) {
                    zip.folder(item.path);
                } else {
                    zip.file(item.path, item.content);
                }
            });

            const compressionOption = currentCompressLevel === 0 ? "STORE" : "DEFLATE";

            showToast('ZIPファイルを生成中...');
            zip.generateAsync({
                type: "blob",
                compression: compressionOption,
                compressionOptions: {
                    level: currentCompressLevel
                }
            }).then((blob) => {
                saveAs(blob, zipFilename);
                showToast(`${zipFilename} の作成が完了しました！`);
            }).catch((err) => {
                showToast('ZIP作成エラー: ' + err.message);
            });
        }

        function setupDropZone(elementId, callback) {
            const area = document.getElementById(elementId);
            if (!area) return;

            ['dragenter', 'dragover'].forEach(eventName => {
                area.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    area.style.background = 'rgba(51, 129, 255, 0.1)';
                }, false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                area.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    area.style.background = '';
                }, false);
            });

            area.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                if (dt.files && dt.files.length > 0) {
                    callback(dt.files);
                }
            });
        }

        function triggerFileInput() {
            document.getElementById('ptz-file-input').click();
        }

        function handlePtzFileSelect(event) {
            const file = event.target.files[0];
            if (file) readPtzFile(file);
        }

        function readPtzFile(file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                if (validateAndApplyJson(e.target.result)) {
                    showToast(`${file.name} を適応しました`);
                }
            };
            reader.readAsText(file);
        }

        function copyJsonToClipboard() {
            ptzCodeArea.select();
            document.execCommand('copy');
            showToast('PTZ.json をコピーしました');
        }

        function downloadJsonFile() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(ptzCodeArea.value);
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `${currentPtz.themeName.toLowerCase().replace(/\s+/g, '_')}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
            showToast('PTZ.json を保存しました');
        }

        // ビュー切り替え機構
        const navItems = document.querySelectorAll('.nav-item');
        const views = document.querySelectorAll('.view');

        function switchView(viewId) {
            navItems.forEach(n => {
                n.classList.remove('active');
                if (n.getAttribute('data-view') === viewId) {
                    n.classList.add('active');
                }
            });

            views.forEach(v => {
                v.classList.remove('active');
                if (v.id === viewId) {
                    v.classList.add('active');
                }
            });
        }

        function openWelcomeDialog() {
            document.getElementById('main-dialog').classList.add('active');
        }
        function closeDialog() {
            document.getElementById('main-dialog').classList.remove('active');
        }

        function showToast(msg) {
            toast.textContent = msg;
            toast.classList.add('active');
            setTimeout(() => {
                toast.classList.remove('active');
            }, 2400);
        }

        function setTheme(isDark) {
            document.body.classList.toggle('dark-mode', isDark);
            themeIcon.textContent = isDark ? 'dark_mode' : 'light_mode';
            
            const root = document.documentElement;
            root.style.setProperty('--bg-base', isDark ? currentPtz.bgDark : currentPtz.bgLight);
        }

        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
        setTheme(prefersDark.matches);

        themeBtn.addEventListener('click', () => {
            setTheme(!document.body.classList.contains('dark-mode'));
        });

        // ユーティリティ関数
        function formatBytes(bytes, decimals = 2) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const dm = decimals < 0 ? 0 : decimals;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
        }

        function escapeHtml(text) {
            return text.replace(/&/g, "&amp;")
                       .replace(/</g, "&lt;")
                       .replace(/>/g, "&gt;")
                       .replace(/"/g, "&quot;")
                       .replace(/'/g, "&#039;");
        }

        // 初期化
        window.onload = () => {
            applyPtz(currentPtz);
            updateCompressLevel(6);
            renderZipItemsList();

            setupDropZone('unzip-drop-zone', (files) => {
                if (files[0]) processZipFile(files[0]);
            });

            setupDropZone('create-drop-zone', (files) => {
                for (let i = 0; i < files.length; i++) {
                    filesToZip.push({
                        path: currentCreatePath + files[i].name,
                        name: files[i].name,
                        content: files[i],
                        size: files[i].size,
                        isText: false,
                        isFolder: false
                    });
                }
                renderZipItemsList();
                showToast(`${files.length} 個のファイルを追加しました`);
            });

            setupDropZone('ptz-drop-area', (files) => {
                if (files[0]) readPtzFile(files[0]);
            });
        };
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1.0, user-scalable=no">
    <title>We-Zip - Web ZIP Extractor & Archiver</title>

    <!-- Google Fonts & Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">

    <!-- JSZip & FileSaver for Browser Zip Processing -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

    <style>
        /* デフォルトテーマ（PTZ.jsonのデフォルト値と連動） */
        :root {
            --accent-primary: #3381FF;
            --accent-active: #1A5FCC;
            
            /* PTZ 規格初期値 */
            --ptz-theme-name: "Default Blue PTZ";
            --ptz-card-radius: 24px;
            --ptz-slider-height: 16px;
            --ptz-toggle-width: 54px;
            --ptz-toggle-height: 30px;
            --ptz-toggle-knob-radius: 50%;
            --ptz-toggle-knob-width: 22px;
            --ptz-blur-intensity: 0px;

            /* Light Mode ベースカラー */
            --bg-base: #F7F7F7;
            --glass-bg: #FFFFFF;
            --text-main: #000000;
            --text-sub: #666666;
            --bg-secondary: #EEEEEE;
            --nav-bg: #FFFFFF;
            --nav-icon-active: #000000;
            
            --m3-easing: cubic-bezier(0.32, 0.72, 0, 1);
            --transition-smooth: 0.35s var(--m3-easing);
            --card-padding: 24px;
        }

        /* ダークモード */
        .dark-mode {
            --bg-base: #121212;
            --glass-bg: #1E1E1E;
            --text-main: #FFFFFF;
            --text-sub: #A1A1A6;
            --bg-secondary: #2C2C2E;
            --nav-bg: #1E1E1E;
            --nav-icon-active: #FFFFFF;
        }

        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Plus Jakarta Sans', 'Noto Sans JP', sans-serif;
            background-color: var(--bg-base);
            color: var(--text-main);
            transition: background-color var(--transition-smooth), color var(--transition-smooth);
            overflow: hidden;
            height: 100vh;
            width: 100vw;
        }

        /* アプリ全体のコンテナ */
        #app-viewport {
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        /* ヘッダー */
        header {
            height: 64px;
            padding: 0 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--glass-bg);
            transition: background-color var(--transition-smooth);
            position: relative;
            flex-shrink: 0;
        }
        .logo {
            font-weight: 700;
            font-size: 18px;
            letter-spacing: -0.5px;
            color: var(--text-main);
            text-align: center;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .logo-mascot {
            width: 28px;
            height: 28px;
            object-fit: contain;
        }
        .theme-toggle {
            position: absolute;
            right: 24px;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: none;
            background: var(--bg-secondary);
            color: var(--text-main);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background var(--transition-smooth), transform 0.2s;
        }
        .theme-toggle:active {
            transform: scale(0.9);
        }

        /* メインコンテンツ */
        main {
            flex-grow: 1;
            overflow-y: auto;
            padding: 24px 20px 100px;
            max-width: 720px;
            width: 100%;
            margin: 0 auto;
            -webkit-overflow-scrolling: touch;
        }

        /* フラットソリッドカード */
        .glass-card {
            background: var(--glass-bg);
            border-radius: var(--ptz-card-radius);
            padding: var(--card-padding);
            margin-bottom: 20px;
            box-shadow: none !important;
            border: none !important;
            transition: background-color var(--transition-smooth), border-radius var(--transition-smooth);
        }

        h2 { 
            font-size: 18px; 
            margin-top: 0; 
            margin-bottom: 12px;
            font-weight: 700; 
            letter-spacing: -0.3px;
        }
        p {
            font-size: 13.5px;
            line-height: 1.5;
            margin-top: 0;
            margin-bottom: 16px;
            color: var(--text-sub);
        }

        /* ------------------ パンくず・階層バー ------------------ */
        .breadcrumb-bar {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 4px;
            padding: 8px 12px;
            background: var(--bg-secondary);
            border-radius: 12px;
            margin-bottom: 12px;
            font-size: 13px;
            font-weight: 600;
        }
        .breadcrumb-item {
            display: flex;
            align-items: center;
            gap: 4px;
            cursor: pointer;
            color: var(--accent-primary);
            transition: opacity 0.2s;
        }
        .breadcrumb-item:hover {
            opacity: 0.8;
        }
        .breadcrumb-item.active {
            color: var(--text-main);
            cursor: default;
        }
        .breadcrumb-separator {
            color: var(--text-sub);
            font-size: 14px;
        }

        /* リストコンポーネント */
        .custom-list {
            display: flex;
            flex-direction: column;
            gap: 2px;
            margin-bottom: 16px;
        }
        .list-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 8px;
            border-bottom: 1px solid var(--bg-secondary);
            border-radius: 8px;
            transition: background 0.15s;
        }
        .list-item.clickable {
            cursor: pointer;
        }
        .list-item.clickable:hover {
            background: rgba(0, 0, 0, 0.03);
        }
        .dark-mode .list-item.clickable:hover {
            background: rgba(255, 255, 255, 0.04);
        }
        .list-item:last-child {
            border-bottom: none;
        }
        .list-item-title {
            font-weight: 600;
            font-size: 14px;
            word-break: break-all;
        }
        .list-item-desc {
            font-size: 12px;
            color: var(--text-sub);
        }

        /* 太いスライダー */
        .slider-wrapper {
            margin: 16px 0;
        }
        .slider-label-row {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
        }
        .thick-slider-container {
            position: relative;
            width: 100%;
            height: var(--ptz-slider-height);
            background: var(--bg-secondary);
            border-radius: calc(var(--ptz-slider-height) / 2);
            overflow: hidden;
            cursor: pointer;
            transition: height var(--transition-smooth);
        }
        .thick-slider-fill {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            width: 50%;
            background: var(--accent-primary);
            transition: background-color var(--transition-smooth), width 0.1s ease-out;
        }
        .thick-slider-input {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer;
            margin: 0;
        }

        /* アクションボタン */
        .ai-btn {
            border: none;
            outline: none;
            padding: 12px 24px;
            border-radius: 14px;
            font-weight: 600;
            font-size: 14px;
            color: white;
            cursor: pointer;
            background: var(--accent-primary);
            transition: transform 0.2s, background-color var(--transition-smooth);
            display: inline-flex;
            align-items: center;
            gap: 8px;
            justify-content: center;
        }
        .ai-btn:hover {
            transform: scale(1.02);
        }
        .ai-btn:active {
            background: var(--accent-active);
            transform: scale(0.96);
        }
        .ai-btn-secondary {
            background: var(--bg-secondary);
            color: var(--text-main);
        }

        /* インプットテキスト */
        .glass-input-wrapper {
            margin-bottom: 14px;
        }
        .glass-input {
            width: 100%;
            padding: 12px 16px;
            border-radius: 12px;
            border: none;
            background: var(--bg-secondary);
            color: var(--text-main);
            font-size: 14px;
            font-family: inherit;
            box-sizing: border-box;
            transition: background var(--transition-smooth);
        }
        .glass-input:focus {
            outline: 2px solid var(--accent-primary);
        }

        /* 固定ナビバー */
        .bottom-nav-container {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 72px;
            background: var(--nav-bg);
            border-top: 1px solid var(--bg-secondary);
            z-index: 500;
            display: flex;
            justify-content: space-around;
            align-items: center;
            padding-bottom: env(safe-area-inset-bottom);
            transition: background-color var(--transition-smooth), border-color var(--transition-smooth);
        }
        .nav-item {
            flex: 1;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: var(--text-sub);
            transition: color 0.25s var(--m3-easing);
            position: relative;
            gap: 4px;
        }
        .nav-item span.material-symbols-outlined {
            font-size: 24px;
            font-variation-settings: 'FILL' 0, 'wght' 400;
            transition: font-variation-settings 0.2s, color 0.2s;
        }
        .nav-label {
            font-size: 10px;
            font-weight: 600;
        }
        .nav-item.active {
            color: var(--nav-icon-active);
        }
        .nav-item.active span.material-symbols-outlined {
            font-variation-settings: 'FILL' 1, 'wght' 700;
        }

        /* ビュー切り替え */
        .view {
            display: none;
        }
        .view.active {
            display: block;
            animation: viewIn 0.3s var(--m3-easing);
        }
        @keyframes viewIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ドロップゾーン & エディタ */
        .ptz-dropzone {
            border: 2px dashed var(--text-sub);
            border-radius: var(--ptz-card-radius);
            padding: 24px;
            text-align: center;
            cursor: pointer;
            background: rgba(0, 0, 0, 0.02);
            transition: background 0.2s, border-color 0.2s;
            margin-bottom: 16px;
        }
        .dark-mode .ptz-dropzone {
            background: rgba(255, 255, 255, 0.02);
        }
        .ptz-dropzone:hover {
            background: rgba(51, 129, 255, 0.05);
            border-color: var(--accent-primary);
        }
        .json-textarea {
            width: 100%;
            height: 220px;
            font-family: monospace;
            font-size: 12.5px;
            padding: 16px;
            background: var(--bg-secondary);
            color: var(--text-main);
            border: none;
            border-radius: var(--ptz-card-radius);
            resize: vertical;
            outline: none;
            line-height: 1.4;
            transition: background var(--transition-smooth);
        }
        .json-textarea:focus {
            box-shadow: 0 0 0 2px var(--accent-primary);
        }

        .preset-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
            gap: 10px;
            margin-top: 10px;
        }
        .preset-btn {
            background: var(--bg-secondary);
            color: var(--text-main);
            border: none;
            padding: 10px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            text-align: center;
            transition: background 0.2s, transform 0.1s;
        }
        .preset-btn:active {
            transform: scale(0.97);
        }

        /* トースト & ダイアログ */
        .toast {
            position: fixed;
            bottom: 84px;
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            background: var(--text-main);
            color: var(--glass-bg);
            padding: 10px 20px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 600;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s var(--m3-easing);
            z-index: 2000;
        }
        .toast.active {
            opacity: 1;
            visibility: visible;
            transform: translateX(-50%) translateY(0);
        }

        .dialog-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 1000; display: flex; align-items: center; justify-content: center;
            opacity: 0; visibility: hidden; transition: all 0.3s var(--m3-easing);
        }
        .dialog-overlay.active { opacity: 1; visibility: visible; }
        .glass-dialog {
            background: var(--glass-bg);
            border-radius: var(--ptz-card-radius);
            padding: 24px; max-width: 380px; width: 90%; text-align: center;
            transform: scale(0.9) translateY(20px); transition: all 0.4s var(--m3-easing);
        }
        .dialog-overlay.active .glass-dialog { transform: scale(1) translateY(0); }

        .badge {
            background: var(--accent-primary);
            color: white;
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 700;
            display: inline-block;
        }

        .mascot-hero {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 16px;
        }
        .mascot-hero img {
            width: 64px;
            height: 64px;
            object-fit: contain;
            flex-shrink: 0;
            filter: drop-shadow(0 4px 6px rgba(0,0,0,0.1));
        }
        .action-btn-group {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 12px;
        }
        .icon-btn-small {
            background: none;
            border: none;
            color: var(--accent-primary);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 6px;
            border-radius: 8px;
            transition: background 0.2s;
        }
        .icon-btn-small:hover {
            background: var(--bg-secondary);
        }
    </style>
</head>
<body>

    <div id="app-viewport">
        <!-- ヘッダー -->
        <header>
            <div class="logo">
                <img src="https://raw.githubusercontent.com/Polandballhub-Operator/pbimagesPublic/refs/heads/main/balls/usa/normal.png" alt="USA Ball Mascot" class="logo-mascot">
                We-Zip
            </div>
            <button class="theme-toggle" id="theme-btn" title="テーマ切り替え">
                <span class="material-symbols-outlined">light_mode</span>
            </button>
        </header>

        <!-- メインコンテンツ -->
        <main>
            <!-- 1. ZIP展開ビュー -->
            <section id="view-unzip" class="view active">
                <div class="glass-card">
                    <div class="mascot-hero">
                        <img src="https://raw.githubusercontent.com/Polandballhub-Operator/pbimagesPublic/refs/heads/main/balls/usa/normal.png" alt="USA Ball">
                        <div>
                            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                                <span class="badge">Unzip Engine</span>
                                <span style="font-size: 11px; color: var(--text-sub);">We-Zip v1.1</span>
                            </div>
                            <h2 style="margin:0; font-size: 16px;">ZIP展開・階層閲覧</h2>
                        </div>
                    </div>
                    <p>
                        Web上でZIPファイルを解凍し、フォルダ階層をたどってファイルの閲覧やダウンロードを行えます。
                    </p>

                    <!-- ドラッグ＆ドロップ ゾーン -->
                    <div class="ptz-dropzone" id="unzip-drop-zone" onclick="document.getElementById('unzip-file-input').click()">
                        <span class="material-symbols-outlined" style="font-size: 40px; color: var(--accent-primary); margin-bottom: 8px;">unarchive</span>
                        <div style="font-weight: 700; font-size: 14px;">ここに ZIP ファイルをドロップ、またはクリック</div>
                        <div style="font-size: 12px; color: var(--text-sub); margin-top: 4px;">.zip アーカイブの解凍・解析を開始</div>
                        <input type="file" id="unzip-file-input" accept=".zip" style="display: none;" onchange="handleUnzipSelect(event)">
                    </div>
                </div>

                <!-- 解凍結果カード（階層閲覧機能付） -->
                <div class="glass-card" id="unzip-results-card" style="display: none;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <h2 style="margin: 0;" id="unzip-archive-title">アーカイブ内容</h2>
                        <button class="ai-btn" style="padding: 6px 12px; font-size: 12px;" onclick="downloadAllExtractedFiles()">
                            <span class="material-symbols-outlined" style="font-size: 16px;">download_for_offline</span>
                            すべてダウンロード
                        </button>
                    </div>

                    <!-- 解凍用パンくずナビゲーション -->
                    <div class="breadcrumb-bar" id="unzip-breadcrumb">
                        <!-- 動的に挿入 -->
                    </div>

                    <p id="unzip-file-count" style="margin-bottom: 8px;">0 個のアイテム</p>
                    
                    <div class="custom-list" id="unzip-file-list">
                        <!-- 動的にファイル・フォルダが挿入されます -->
                    </div>
                </div>
            </section>

            <!-- 2. ZIP作成・圧縮ビュー（新規フォルダ作成＆階層管理対応） -->
            <section id="view-zip" class="view">
                <div class="glass-card">
                    <div class="mascot-hero">
                        <img src="https://raw.githubusercontent.com/Polandballhub-Operator/pbimagesPublic/refs/heads/main/balls/usa/normal.png" alt="USA Ball">
                        <div>
                            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                                <span class="badge">Zip Creator</span>
                                <span style="font-size: 11px; color: var(--text-sub);">フォルダ階層構築対応</span>
                            </div>
                            <h2 style="margin:0; font-size: 16px;">ZIP圧縮・作成</h2>
                        </div>
                    </div>
                    <p>
                        フォルダ構造を作成し、ファイルや新規テキストを追加して1つのZIPファイルにまとめます。
                    </p>

                    <div class="glass-input-wrapper">
                        <label style="font-size: 12px; font-weight: 700; display: block; margin-bottom: 6px;">出力ZIPファイル名</label>
                        <input type="text" class="glass-input" id="zip-filename-input" value="Archive.zip" placeholder="Archive.zip">
                    </div>

                    <!-- 圧縮レベル設定 -->
                    <div class="slider-wrapper">
                        <div class="slider-label-row">
                            <span>圧縮レベル (0: 無圧縮 - 9: 最大)</span>
                            <span id="val-compress-level">6 (標準)</span>
                        </div>
                        <div class="thick-slider-container">
                            <div class="thick-slider-fill" id="slider-compress-fill" style="width: 66%;"></div>
                            <input type="range" class="thick-slider-input" id="compress-level-input" min="0" max="9" value="6" oninput="updateCompressLevel(this.value)">
                        </div>
                    </div>
                </div>

                <!-- 階層作成 ＆ ファイル追加エリア -->
                <div class="glass-card">
                    <h2>ファイル＆フォルダ構造の作成</h2>
                    <p>現在のフォルダー配下に新しいフォルダを作成したり、ファイルを直接読み込みます。</p>

                    <!-- 作成用パンくずナビゲーション -->
                    <div class="breadcrumb-bar" id="create-breadcrumb">
                        <!-- 動的に挿入 -->
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px;">
                        <button class="ai-btn ai-btn-secondary" style="width: 100%; font-size: 13px;" onclick="openCreateFolderDialog()">
                            <span class="material-symbols-outlined">create_new_folder</span>
                            新規フォルダ追加
                        </button>
                        <button class="ai-btn ai-btn-secondary" style="width: 100%; font-size: 13px;" onclick="document.getElementById('create-file-input').click()">
                            <span class="material-symbols-outlined">upload_file</span>
                            ファイル読み込み
                        </button>
                        <input type="file" id="create-file-input" multiple style="display: none;" onchange="handleFilesToZipSelect(event)">
                    </div>

                    <!-- ドロップゾーン -->
                    <div class="ptz-dropzone" id="create-drop-zone" style="padding: 16px; margin-bottom: 12px;" onclick="document.getElementById('create-file-input').click()">
                        <div style="font-weight: 600; font-size: 13px;">カレントフォルダにドラッグ＆ドロップ</div>
                    </div>
                </div>

                <!-- Web上でのテキスト新規作成カード -->
                <div class="glass-card">
                    <h2>新規テキストファイル追加</h2>
                    <p>選択中のフォルダー内に保存するテキストを作成します。</p>
                    
                    <div class="glass-input-wrapper">
                        <input type="text" class="glass-input" id="new-text-name" placeholder="ファイル名 (例: readme.txt)">
                    </div>
                    <div class="glass-input-wrapper">
                        <textarea class="json-textarea" id="new-text-content" style="height: 90px;" placeholder="ここにファイル内容を入力..."></textarea>
                    </div>
                    <button class="ai-btn ai-btn-secondary" style="width: 100%;" onclick="addTextFileToZipList()">
                        <span class="material-symbols-outlined">add</span>
                        カレントフォルダに追加
                    </button>
                </div>

                <!-- 構成一覧 -->
                <div class="glass-card">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <h2>現在のフォルダー内容</h2>
                        <button class="preset-btn" style="padding: 4px 8px; margin:0;" onclick="clearZipList()">全初期化</button>
                    </div>
                    
                    <div class="custom-list" id="zip-items-list">
                        <!-- 動的に挿入 -->
                    </div>

                    <div style="margin-top: 16px;">
                        <button class="ai-btn" id="build-zip-btn" style="width: 100%;" onclick="buildAndDownloadZip()">
                            <span class="material-symbols-outlined">folder_zip</span>
                            ZIPアーカイブを作成して保存
                        </button>
                    </div>
                </div>
            </section>

            <!-- 3. テーマ・設定・USAマスコットビュー -->
            <section id="view-settings" class="view">
                <div class="glass-card">
                    <div class="mascot-hero">
                        <img src="https://raw.githubusercontent.com/Polandballhub-Operator/pbimagesPublic/refs/heads/main/balls/usa/normal.png" alt="USA Ball Mascot">

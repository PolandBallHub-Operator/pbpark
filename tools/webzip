                        <div id="json-error-msg" style="color: #FF3B30; font-size: 12px; margin-top: 6px; display: none; font-weight: 600;"></div>
                    </div>

                    <div style="margin-top: 16px;">
                        <button class="ai-btn" style="width: 100%;" onclick="applyJsonFromTextArea()">
                            <span class="material-symbols-outlined">done_all</span>
                            変更を適用
                        </button>
                    </div>
                </div>

                <!-- プリセット・テーマ -->
                <div class="glass-card">
                    <h2>プリセット・テーマ</h2>
                    <p>PTZ.jsonのワンタップ・プリセット切り替えです。</p>
                    <div class="preset-grid">
                        <button class="preset-btn" onclick="loadPreset('default')">Default Blue</button>
                        <button class="preset-btn" onclick="loadPreset('sharpPurple')">Sharp Purple (角丸0)</button>
                        <button class="preset-btn" onclick="loadPreset('chunkyRose')">Chunky Rose (極厚)</button>
                        <button class="preset-btn" onclick="loadPreset('minimalGray')">Minimal Monochrome</button>
                    </div>
                </div>
